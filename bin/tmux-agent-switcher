# SECTION: Cursor Adapter
# Source: adapters/cursor.py
# ==============================================================================
"""Cursor agent adapter."""

class CursorAdapter(BaseAgentAdapter):
    name = "cursor"
    display_name = "⚡ Cursor"
    color = C_CURSOR

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return "cursor-agent" in heads or "cursor-agent" in pane.current_command or "cursor-agent" in full_desc

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        m_files = glob.glob(os.path.expanduser("~/.cursor/projects/**/worker.log"), recursive=True)
        mtime = max((os.path.getmtime(f) for f in m_files), default=0.0)
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        return self.display_name, self.color, 2, mtime, disp_t, False

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        try:
            pane_pids = {str(pane.pid), *desc_pids}
            cursor_pids = []
            ps_out = subprocess.run(["ps", "-eo", "pid,ppid,command"], capture_output=True).stdout.decode().splitlines()
            for line in ps_out[1:]:
                proc = line.strip().split(None, 2)
                if len(proc) == 3 and proc[0] in pane_pids and re.search(r"(?:^|[ /])cursor-agent(?:\s|$)", proc[2]):
                    cursor_pids.append(proc[0])

            session_ids = set()
            lsof = shutil.which("lsof")
            if cursor_pids and lsof:
                opened = subprocess.run(
                    [lsof, "-a", "-p", ",".join(cursor_pids), "-Fn"],
                    capture_output=True,
                    timeout=1
                ).stdout.decode(errors="replace")
                session_ids = set(re.findall(r"/\.cursor/chats/[^/]+/([0-9a-f-]{36})/store\.db(?:$|[-\n])", opened, re.MULTILINE))

            sid = next(iter(session_ids)) if len(session_ids) == 1 else ""
            if not sid:
                try:
                    screen = subprocess.check_output(
                        ["tmux", "capture-pane", "-pJ", "-S", "-20", "-t", pane.pane_id]
                    ).decode()
                    short_ids = set(re.findall(r"(?:·|›)\s*([0-9a-f]{8})\s*(?:·|›)", screen))
                    candidates = session_ids or {
                        os.path.basename(p)[:-6]
                        for p in glob.glob(os.path.expanduser("~/.cursor/projects/*/agent-transcripts/*/*.jsonl"))
                    }
                    matched = {s for s in candidates if s[:8] in short_ids}
                    if len(matched) == 1:
                        sid = next(iter(matched))
                except Exception:
                    pass

            matches = glob.glob(os.path.expanduser(f"~/.cursor/projects/*/agent-transcripts/{sid}/{sid}.jsonl")) if sid else []
            if matches:
                transcript = max(matches, key=os.path.getmtime)
                records = []
                for line in read_tail_lines(transcript, full=full_history):
                    try:
                        record = json.loads(line)
                    except Exception:
                        continue
                    role = record.get("role")
                    if role not in ("user", "assistant"):
                        continue
                    parts = record.get("message", {}).get("content", [])
                    text = "\n".join(p.get("text", "") for p in parts if isinstance(p, dict) and p.get("type") == "text")
                    if role == "user":
                        query = re.search(r"<user_query>(.*?)</user_query>", text, re.DOTALL)
                        text = query.group(1).strip() if query else re.sub(r"<timestamp>.*?</timestamp>", "", text, flags=re.DOTALL)
                    records.append(json.dumps({"role": role, "content": text}))

                turns = extract_duck_turns(records, full=full_history)
                if turns:
                    is_live = False
                    try:
                        is_live = time.time() - os.path.getmtime(transcript) < 120
                    except Exception:
                        pass
                    content = format_turns(turns, live=is_live, full_history=full_history, preview_width=preview_width)
                    return PreviewResult(
                        source_label=f"{self.display_name} · {disp_t} · {sid[:8]}",
                        content=content
                    )
        except Exception:
            pass
        return None


# ==============================================================================
# SECTION: OpenAI Codex Adapter
# Source: adapters/codex.py
# ==============================================================================
"""OpenAI Codex adapter."""

class CodexAdapter(BaseAgentAdapter):
    name = "codex"
    display_name = "⚡ Codex"
    color = C_CODEX

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return "codex" in heads or "codex" in full_desc or "@openai/codex" in full_desc

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        codex_threads = shared_state.get("codex_threads", {})
        codex_cwd = shared_state.get("codex_cwd", {})

        spinning = bool(re.match(r"\s*[⠀-⣿]", pane.title))
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        clean_t = disp_t.split("|")[0].strip("[]* ")

        mtime = 0.0
        for k, (tid, u_time) in codex_threads.items():
            if k == clean_t or k in clean_t or clean_t in k:
                mtime = max(mtime, u_time)

        mtime = mtime or codex_cwd.get(pane.cwd, 0.0)

        status = "💤 idle"
        rank = 2
        running = False
        if spinning:
            status = "⚡ run"
            rank = 1
            running = True

        return self.display_name, self.color, rank, mtime, disp_t, running

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        clean_t = disp_t.split("|")[0].strip("[]* ")

        s_db = os.path.expanduser("~/.codex/state_5.sqlite")
        h_db = os.path.expanduser("~/.codex/thread_history_1.sqlite")

        if os.path.exists(s_db) and os.path.exists(h_db):
            try:
                conn_s = sqlite3.connect(f"file:{s_db}?mode=ro", uri=True)
                row = conn_s.execute(
                    'SELECT id, name FROM threads WHERE name = ? OR name LIKE ? OR ? LIKE "%" || name || "%" ORDER BY updated_at_ms DESC LIMIT 1',
                    (clean_t, f"%{clean_t}%", clean_t)
                ).fetchone()
                conn_s.close()

                if row:
                    tid, _ = row
                    conn_h = sqlite3.connect(f"file:{h_db}?mode=ro", uri=True)
                    items = conn_h.execute(
                        'SELECT item_type, item_json FROM thread_items WHERE thread_id = ? AND item_type IN ("userMessage", "agentMessage") ORDER BY created_at_ms DESC LIMIT ?',
                        (tid, -1 if full_history else 15)
                    ).fetchall()
                    conn_h.close()

                    raw_records = []
                    for itype, ijson in items:
                        try:
                            d = json.loads(ijson)
                        except Exception:
                            continue
                        r = "assistant" if itype == "agentMessage" else "user"
                        raw_records.append(json.dumps({"role": r, "content": d.get("content") or d.get("text")}))

                    turns = extract_duck_turns(raw_records, full=full_history)
                    if turns:
                        content = format_turns(turns, live=True, full_history=full_history, preview_width=preview_width)
                        return PreviewResult(
                            source_label=f"{self.display_name} · {disp_t}",
                            content=content
                        )
            except Exception:
                pass
        return None



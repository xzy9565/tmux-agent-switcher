    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        cmd = pane.current_command
        for m in ("token-monitor", "btop", "htop", "mactop"):
            if m in full_desc or m in cmd:
                cmd = m
                break
        harness = "📊 " + cmd[:8].capitalize()
        title = pane.title if ("monitor" in pane.title.lower() or "btop" in pane.title.lower() or "token" in pane.title.lower()) else f"System Monitor ({cmd})"
        return harness, self.color, 3, 0.0, title, False

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        # Let FallbackTuiAdapter capture terminal buffer with de-noising
        return None


# --- Tier 1 Fallback TUI Adapter (adapters/fallback.py) ---
"""Tier 1 Universal Fallback TUI Adapter & Shell handler."""

class FallbackTuiAdapter(BaseAgentAdapter):
    name = "fallback"
    display_name = "💻 Shell"
    color = C_DIM

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return True  # Fallback matches everything not caught by specialized adapters

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        host = shared_state.get("host", os.uname().nodename.split(".")[0])
        home = shared_state.get("home", os.path.expanduser("~"))

        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        if disp_t in ("", host) + SHELLS:
            where = re.sub("^" + re.escape(home) + "(?=/|$)", "~", pane.cwd)
            where = where if len(where) <= 50 else "…" + where[-49:]
            disp_t = where if pane.current_command in SHELLS else f"{pane.current_command} · {where}"

        return self.display_name, self.color, 4, 0.0, disp_t, False

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).removeprefix("OC | ").strip()
        clean_t = disp_t.split("|")[0].strip("[]* ")
        geom = f"{pane.width}x{pane.height}" if pane.width and pane.height else ""

        try:
            scrollback = "-" if full_history else "-200"
            raw = subprocess.check_output([
                "tmux", "capture-pane", "-epJ", "-S", scrollback, "-t", pane.pane_id
            ]).decode("utf-8", errors="ignore")

            cleaned = denoise_terminal_text(raw)
            if re.search(r"```|^#{1,3}\s+|^\s*[\*\-\•]\s+", cleaned, re.MULTILINE):
                content = render_md(cleaned, preview_width)
            else:
                content = cleaned

            source_label = f"{pane.current_command} · {clean_t[:35]}"
            if geom:
                source_label += f" [{geom}]"

            return PreviewResult(
                source_label=source_label,
                content=content
            )
        except Exception as e:
            return PreviewResult(
                source_label=pane.pane_id,
                content=f"Error capturing pane: {e}"
            )


# --- Adapter Registry (adapters/registry.py) ---
"""Adapter registry and priority dispatcher."""

ADAPTERS: List[BaseAgentAdapter] = [
    Osc7501Adapter(),
    CursorAdapter(),
    CodexAdapter(),
    CommandCodeAdapter(),
    ClaudeAdapter(),
    GrokAdapter(),
    AntigravityAdapter(),
    OpenCodeAdapter(),
    OmpAdapter(),
    SystemMonitorAdapter(),
    FallbackTuiAdapter(),
]

def resolve_adapter(pane: PaneContext, full_desc: str, heads: str) -> BaseAgentAdapter:
    """Find the highest-priority adapter capable of handling this pane."""
    for adapter in ADAPTERS:
        try:
            if adapter.detect(pane, full_desc, heads):
                return adapter
        except Exception:
            continue
    return FallbackTuiAdapter()


# --- Pane Context & Session Resolver (notifications/context.py) ---
"""Resolve notification context from live tmux panes and process trees."""

def _tmux_cmd(args: List[str], timeout: float = 0.5) -> str:
    try:
        res = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return res.stdout or ""
    except Exception:
        return ""

def list_context_panes() -> List[Dict[str, str]]:
    fmt = "#{pane_id}\t#{session_name}:#{window_index}.#{pane_index}\t#{pane_pid}\t#{pane_tty}\t#{pane_current_path}\t#{pane_title}"
    result = []
    for line in _tmux_cmd(["tmux", "list-panes", "-a", "-F", fmt]).splitlines():
        fields = line.split("\t", 5)
        if len(fields) == 6 and re.fullmatch(r"%\d+", fields[0]):
            result.append(dict(zip(("pane", "location", "pid", "pane_tty", "cwd", "title"), fields)))
    return result

def get_pane_processes(candidates: List[Dict[str, str]]) -> Dict[str, Tuple[str, str, str]]:
    ttys = sorted({p["pane_tty"].removeprefix("/dev/") for p in candidates if p.get("pane_tty")})
    if not ttys:
        return {}
    result = {}
    for line in _tmux_cmd(["ps", "-t", ",".join(ttys), "-o", "pid=,ppid=,tty=,command="]).splitlines():
        fields = line.strip().split(None, 3)
        if len(fields) == 4:
            result[fields[0]] = (fields[1], fields[2], fields[3])
    return result

def find_codex_clients(pane: Dict[str, str], procs: Dict[str, Tuple[str, str, str]]) -> List[List[str]]:
    children = collections.defaultdict(list)
    for pid, proc in procs.items():
        children[proc[0]].append(pid)
    found, stack, seen = [], [pane["pid"]], set()
    while stack:
        pid = stack.pop()
        if pid in seen:
            continue
        seen.add(pid)
        stack.extend(children[pid])
        proc = procs.get(pid, ("", "", ""))
        if proc[1] != pane["pane_tty"].removeprefix("/dev/"):
            continue
        argv = proc[2].split()
        if argv and Path(argv[0]).name in ("node", "nodejs"):
            argv = argv[1:]
        if argv and Path(argv[0]).name == "codex" and not any(
            a in ("app-server", "exec-server", "sandbox", "exec", "review", "debug", "--help", "-h", "--version", "-V")
            for a in argv[1:]
        ):
            found.append(argv)
    return found

def get_codex_thread_metadata(session_id: str) -> Dict[str, Any]:
    root = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
    databases = sorted(
        root.glob("state_*.sqlite"),
        key=lambda p: int(p.stem.split("_")[-1]) if p.stem.split("_")[-1].isdigit() else 0,
        reverse=True
    )
    for path in databases:
        try:
            with sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, timeout=0.2) as db:
                db.row_factory = sqlite3.Row
                row = db.execute("SELECT * FROM threads WHERE id=?", (session_id,)).fetchone()
                if row:
                    row_dict = dict(row)
                    name = row_dict.get("name") or ""
                    if name and db.execute(
                        "SELECT count(*) FROM threads WHERE name=? AND cwd=? AND archived=0",
                        (name, row_dict["cwd"])
                    ).fetchone()[0] > 1:
                        row_dict["name"] = ""
                    return row_dict
        except Exception:
            continue
    return {}

def matches_codex_thread(pane: Dict[str, str], metadata: Dict[str, Any]) -> bool:
    name, cwd = metadata.get("name", ""), metadata.get("cwd", "")
    title = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.get("title", "")).strip()
    return bool(name and cwd and os.path.realpath(pane.get("cwd", "")) == os.path.realpath(cwd) and (title == name or title.startswith(name + " | ")))

def get_claude_sessions_meta() -> List[Dict[str, Any]]:
    sessions = []
    for f in glob.glob(os.path.expanduser("~/.claude*/sessions/*.json")):
        try:
            with open(f, "r", encoding="utf-8") as fp:
                sessions.append(json.load(fp))
        except Exception:
            pass
    return sessions

def resolve_claude_pane(sid: str, lookup: Any, live: List[Dict[str, str]]) -> Optional[Dict[str, str]]:
    if not sid:
        return None
    tagged = []
    for line in _tmux_cmd(["tmux", "list-panes", "-a", "-F", "#{pane_id}\t#{@claude-session-id}"]).splitlines():
        fields = line.split("\t")
        if len(fields) == 2 and fields[1] == sid:
            pane = lookup(fields[0])
            if pane:
                tagged.append(pane)
    if len(tagged) == 1:
        return tagged[0]

    sessions = get_claude_sessions_meta()
    for s in sessions:
        if s.get("sessionId") == sid and s.get("tmux"):
            pane_id = s["tmux"].split(".")[-1] if "." in s["tmux"] else s["tmux"]
            pane = lookup(pane_id)
            if pane:
                return pane
        if s.get("sessionId") == sid:
            job_id = s.get("jobId")
            if job_id:
                for parent in sessions:
                    if parent.get("parkedJobId") == job_id and parent.get("tmux"):
                        pane_id = parent["tmux"].split(".")[-1] if "." in parent["tmux"] else parent["tmux"]
                        pane = lookup(pane_id)
                        if pane:
                            return pane

    for s in sessions:
        if (s.get("jobId") and sid.startswith(s["jobId"])) or (s.get("parkedJobId") and sid.startswith(s["parkedJobId"])):
            if s.get("tmux"):
                pane_id = s["tmux"].split(".")[-1] if "." in s["tmux"] else s["tmux"]
                pane = lookup(pane_id)
                if pane:
                    return pane
    return None

def resolve_agent_pane(
    agent: str,
    payload: Dict[str, Any],
    live: List[Dict[str, str]],
    procs: Dict[str, Any],
    metadata: Dict[str, Any],
    explicit: str = "",
    inherited: str = ""
) -> Optional[Dict[str, str]]:
    def lookup(target: str) -> Optional[Dict[str, str]]:
        return next((p for p in live if target in (p["pane"], p["location"])), None)

    if explicit:
        return lookup(explicit)

    agent_lower = agent.lower()
    if agent_lower == "codex":
        sid = payload.get("session_id") or payload.get("thread-id") or ""
        if not sid or metadata.get("source") not in (None, "cli"):
            return None
        named = []
        for pane in live:
            clients = find_codex_clients(pane, procs)
            if not clients:
                continue
            if matches_codex_thread(pane, metadata):
                named.append(pane)
        return named[0] if len(named) == 1 else None

    is_claude = agent_lower in ("claude", "claude code", "claudecode") or (
        not agent and "transcript_path" in payload and payload.get("hook_event_name")
    )
    if is_claude:
        sid = payload.get("session_id") or payload.get("sessionId") or ""
        pane = resolve_claude_pane(sid, lookup, live)
        if pane:
            return pane

    conversation = payload.get("conversationId")
    if conversation:
        tagged = []
        for line in _tmux_cmd(["tmux", "list-panes", "-a", "-F", "#{pane_id}\t#{@agy-session-id}"]).splitlines():
            fields = line.split("\t")
            if len(fields) == 2 and fields[1] == conversation:
                pane = lookup(fields[0])
                if pane:
                    tagged.append(pane)
        return tagged[0] if len(tagged) == 1 else None

    return lookup(inherited) if inherited else None

def resolve_client_context(pane: Optional[Dict[str, str]], clients: List[List[str]]) -> Dict[str, Any]:
    """Determine focus status and client tty for a given pane."""
    if not pane:
        return {"pane": "", "location": "", "focused": False, "pane_tty": "", "client_tty": ""}
    matching = [c for c in clients if c[0] == pane["pane"]]
    focused = [c for c in matching if "focused" in c[2].split(",")]
    session = pane["location"].rsplit(":", 1)[0]
    same_session = [c for c in clients if len(c) > 3 and c[3] == session]
    client = (focused or matching or (same_session if len(same_session) == 1 else []) or [None])[0]
    return {
        "pane": pane["pane"],
        "location": pane["location"],
        "focused": bool(focused),
        "pane_tty": pane.get("pane_tty", ""),
        "client_tty": client[1] if client else "",
        "client_term": client[5] if client and len(client) > 5 else ""
    }

def resolve_notification_context(
    agent_name: str,
    payload: Dict[str, Any],
    target_pane: str = "",
    tag_session: bool = True
) -> Dict[str, Any]:
    """Resolve active target pane, terminal paths, and client focus."""
    sid = payload.get("session_id") or payload.get("sessionId") or payload.get("thread-id") or ""
    live = list_context_panes()
    metadata = get_codex_thread_metadata(sid) if sid and agent_name.lower() == "codex" else {}
    candidates = [p for p in live if target_pane in (p["pane"], p["location"]) or matches_codex_thread(p, metadata)]
    procs = get_pane_processes(candidates) if agent_name.lower() == "codex" else {}

    inherited = os.environ.get("TMUX_PANE", "")
    pane = resolve_agent_pane(agent_name, payload, live, procs, metadata, target_pane, inherited)

    # Inspect clients for focus state
    fmt = "#{pane_id}\t#{client_tty}\t#{client_flags}\t#{session_name}\t#{client_pid}\t#{client_termname}"
    client_lines = _tmux_cmd(["tmux", "list-clients", "-F", fmt]).splitlines()
    clients = [c.split("\t") for c in client_lines if len(c.split("\t")) == 6]
    # A client attached over SSH carries SSH_* in its own env. The hook's env only shows how the server started.
    remote = [c for c in clients if re.search(r" SSH_(CONNECTION|TTY|CLIENT)=", _tmux_cmd(["ps", "eww", "-o", "command=", "-p", c[4]]))]
    where = {"remote_clients": [(c[1], c[5]) for c in remote], "local_client": len(remote) < len(clients)}

    if not pane:
        return {"pane": "", "location": "", "focused": False, "pane_tty": "", "client_tty": "", **where}

    if sid and tag_session:
        if agent_name.lower() == "codex" and find_codex_clients(pane, procs):
            _tmux_cmd(["tmux", "set-option", "-p", "-t", pane["pane"], "@codex-session-id", sid])
        elif agent_name.lower() in ("claude", "claude code", "claudecode") or (not agent_name and "transcript_path" in payload):
            _tmux_cmd(["tmux", "set-option", "-p", "-t", pane["pane"], "@claude-session-id", sid])

    return {**resolve_client_context(pane, clients), **where}


# --- Universal Notification Gateway (notifications/gateway.py) ---
"""Universal notification gateway and Tmux event hook observer."""

def _tmux_option(option: str, default: str) -> str:
    try:
        val = subprocess.run(
            ["tmux", "show-option", "-gqv", option],
            capture_output=True,
            text=True,
            timeout=0.3
        ).stdout.strip()
        return val if val else default
    except Exception:
        return default

def handle_clear(pane_id: str) -> None:
    """Clear visual input alert and needs-input flag on a target pane."""
    if not pane_id:
        return
    try:
        subprocess.run(["tmux", "set", "-pu", "-t", pane_id, "pane-border-style"], capture_output=True, timeout=0.2)
        subprocess.run(["tmux", "set", "-pu", "-t", pane_id, "pane-active-border-style"], capture_output=True, timeout=0.2)
        subprocess.run(["tmux", "set", "-pu", "-t", pane_id, "@pane-needs-input"], capture_output=True, timeout=0.2)
    except Exception:
        pass

def handle_focus_out(pane_id: str) -> None:
    """Raise the alert held back while you watched the pane, unless you replied before leaving."""
    if not pane_id:
        return
    try:
        raw = subprocess.run(["tmux", "show", "-pqv", "-t", pane_id, "@pane-alert-pending"], capture_output=True, text=True, timeout=0.2).stdout.strip()
        subprocess.run(["tmux", "set", "-pu", "-t", pane_id, "@pane-alert-pending"], capture_output=True, timeout=0.2)
        pending = json.loads(raw)
    except Exception:
        return
    # A reply adds turns to the transcript, so a changed last uuid means it was answered
    if _get_claude_last_turn_uuid(pending.get("transcript_path", "")) == pending.get("mark"):
        handle_notify(pending.get("agent", ""), pending.get("message", ""), pane_id)

def handle_hook_title(pane_id: str) -> None:
    """Deprecated: Pane title sniffing removed in favor of native agent hooks."""
    pass

def _check_agy_waiting(conv_id: str) -> bool:
    """Check if AGY is currently waiting for background tasks or schedule timers."""
    if not conv_id:
        return False
    agy_tpath = os.path.expanduser(f"~/.gemini/antigravity-cli/brain/{conv_id}/.system_generated/logs/transcript.jsonl")
    if not os.path.exists(agy_tpath):
        return False
    try:
        with open(agy_tpath, "r", encoding="utf-8", errors="ignore") as f:
            lines = f.readlines()[-80:]
        running_tasks = set()
        finished_tasks = set()
        pending_timer = False
        for l in reversed(lines):
            try:
                d = json.loads(l)
                t = d.get("type")
                c = str(d.get("content", ""))
                m_fin = re.findall(r'Task id\s*"([^"]+)"\s*finished', c)
                for tid in m_fin:
                    finished_tasks.add(tid.split("/")[-1])
                if d.get("status") == "RUNNING":
                    m_start = re.search(r'task id:\s*([^\s\n"]+)', c)
                    if m_start:
                        t_id = m_start.group(1).split("/")[-1]
                        if t_id not in finished_tasks:
                            running_tasks.add(t_id)
                if t == "PLANNER_RESPONSE":
                    tcs = [tc.get("name") for tc in d.get("tool_calls", [])]
                    if "schedule" in tcs and not pending_timer:
                        pending_timer = True
                if "Timer: " in c or "sender=schedule" in c:
                    pending_timer = False
                if t == "USER_INPUT":
                    break
            except Exception:
                pass
        return len(running_tasks) > 0 or pending_timer
    except Exception:
        return False

def _get_claude_last_turn_uuid(transcript_path: str) -> Optional[str]:
    """Extract uuid of the transcript's last user/assistant entry."""
    if not transcript_path or not os.path.isfile(transcript_path):
        return None
    try:
        with open(transcript_path, "r", encoding="utf-8", errors="ignore") as f:
            lines = f.readlines()[-200:]
        for line in reversed(lines):
            try:
                d = json.loads(line)
                if d.get("type") in ("user", "assistant") and d.get("uuid"):
                    return str(d["uuid"])
            except Exception:
                continue
    except Exception:
        pass
    return None

def _idle_teammates(transcript_path: str) -> set:
    """Descriptions of idle in-process teammates. Stop payloads list a teammate as running until it shuts down."""
    names: Dict[str, str] = {}
    idle = set()
    try:
        with open(transcript_path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if '"name":"Agent"' not in line and '"name":"SendMessage"' not in line and "idle_notification" not in line:
                    continue
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                content = (d.get("message") or {}).get("content")
                if d.get("type") == "user" and isinstance(content, str):
                    # A teammate mails the lead an idle_notification each time its turn ends
                    idle.update(re.findall(r'"type":"idle_notification","from":"([^"]+)"', content))
                elif d.get("type") == "assistant" and isinstance(content, list):
                    # Spawning or messaging a teammate puts it back to work
                    for b in content:
                        if b.get("type") != "tool_use":
                            continue
                        inp = b.get("input") or {}
                        if b.get("name") == "Agent" and inp.get("name"):
                            names[inp.get("description", "")] = inp["name"]
                            idle.discard(inp["name"])
                        elif b.get("name") == "SendMessage":
                            idle.discard(inp.get("to"))
    except Exception:
        return set()
    return {desc for desc, name in names.items() if name in idle}

def _dispatch_claude_settle_daemon(
    tp: str,
    mark: str,
    wait_s: float,
    payload: Dict[str, Any],
    agent_name: str,
    message: str,
    target_pane: str,
    force: bool,
) -> None:
    """Spawn detached background daemon to re-dispatch notification after settle/hold wait."""
    self_cmd = sys.argv[0] if sys.argv and os.path.isfile(sys.argv[0]) else "tmux-agent-switcher"
    sub_payload = dict(payload)
    sub_payload["settled"] = True

    daemon_py = (
        "import json, os, subprocess, sys, time\n"
        f"time.sleep({wait_s})\n"
        "curr = None\n"
        "try:\n"
        f"    with open({repr(tp)}, 'r', encoding='utf-8', errors='ignore') as f:\n"
        "        lines = f.readlines()[-200:]\n"
        "    for l in reversed(lines):\n"
        "        try:\n"
        "            d = json.loads(l)\n"
        "            if d.get('type') in ('user', 'assistant') and d.get('uuid'):\n"
        "                curr = str(d['uuid'])\n"
        "                break\n"
        "        except Exception:\n"
        "            pass\n"
        "except Exception:\n"
        "    pass\n"
        f"if curr == {repr(mark)}:\n"
        f"    cmd = [{repr(self_cmd)}, 'notify']\n"
        + (f"    cmd.append({repr(agent_name)})\n" if agent_name else "")
        + (f"    cmd.append({repr(message)})\n" if message else "")
        + (f"    cmd.append({repr(target_pane)})\n" if target_pane else "")
        + ("    cmd.append('--force')\n" if force else "")
        + "    p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n"
        f"    p.communicate(input=json.dumps({repr(sub_payload)}).encode('utf-8'))\n"
    )
    try:
        subprocess.Popen(
            [sys.executable, "-c", daemon_py],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        pass

def _osc9(text: str, term: str) -> str:
    """OSC 9 desktop alert. A client that itself runs inside tmux needs it wrapped for passthrough, every inner ESC doubled."""
    # OSC 9 only: Ghostty and WezTerm also render OSC 777, so sending both shows two banners.
    clean = re.sub(r"[\x00-\x1f\x7f]", " ", text)  # agent text must not end the sequence or inject another
    seq = f"\x1b]9;{clean}\x1b\\"
    if term.startswith(("tmux", "screen")):
        seq = "\x1bPtmux;" + seq.replace("\x1b", "\x1b\x1b") + "\x1b\\"
    return seq

def handle_notify(
    agent_name: str = "",
    message: str = "",
    target_pane: str = "",
    force: bool = False,
    stdin_data: str = ""
) -> None:
    """Universal AI agent notification dispatcher."""
    payload: Dict[str, Any] = {}
    if stdin_data:
        try:
            payload = json.loads(stdin_data)
        except Exception:
            payload = {}

    # Headless SDK suppression
    if os.environ.get("CLAUDE_CODE_ENTRYPOINT", "").startswith("sdk-") and "hook_event_name" in payload:
        return

    # Claude Code Stop hold and settle suppression:
    # 1. Settle: Queued input or fast next-turn results start immediately after Stop,
    #    so settle AGENT_NOTIFY_SETTLE_S (default 3s) first to avoid alert during turn overlap.
    # 2. Hold: While background work is in flight (.background_tasks non-empty), Claude wakes itself
    #    when it lands, so hold AGENT_NOTIFY_HOLD_S (default 1800s) unless the reply asks a question (?).
    #    An idle teammate stays listed but never wakes Claude, so it doesn't hold.
    if not force and payload.get("hook_event_name") == "Stop" and not payload.get("settled"):
        bg_tasks = payload.get("background_tasks") or []
        is_mate = lambda t: isinstance(t, dict) and t.get("type") == "teammate"
        if any(map(is_mate, bg_tasks)):
            idle = _idle_teammates(payload.get("transcript_path", ""))
            bg_tasks = [t for t in bg_tasks if not is_mate(t) or t.get("description") not in idle]
        last_msg = payload.get("last_assistant_message") or ""
        last_para = re.split(r'\n\s*\n', last_msg.rstrip())[-1] if last_msg else ""
        asks_question = bool(re.search(r'\?(\s|$|[*_`)"”’\'])', last_para))

        held = False
        wait_s = float(os.environ.get("AGENT_NOTIFY_SETTLE_S", 3.0))
        if len(bg_tasks) > 0 and not asks_question:
            held = True
            wait_s = float(os.environ.get("AGENT_NOTIFY_HOLD_S", 1800.0))

        tp = payload.get("transcript_path", "")
        if tp and os.path.isfile(tp):
            mark = _get_claude_last_turn_uuid(tp)
            if mark and wait_s > 0:
                _dispatch_claude_settle_daemon(
                    tp, mark, wait_s, payload, agent_name, message, target_pane, force
                )
                return
        if held:
            return

    # Codex goal suppression
    transcript_path = payload.get("transcript_path", "")
    if transcript_path and os.path.isfile(transcript_path):
        try:
            with open(transcript_path, "r", encoding="utf-8", errors="ignore") as f:
                tail = f.readlines()[-30:]
            for line in reversed(tail):
                if "thread_goal_updated" in line:
                    d = json.loads(line)
                    if d.get("payload", {}).get("goal", {}).get("status") == "active":
                        return
                    break
        except Exception:
            pass

    # AGY background task / timer suppression
    conv_id = payload.get("conversationId", "")
    if conv_id:
        if payload.get("fullyIdle") is False:
            return
        if _check_agy_waiting(conv_id):
            return

    # Extract message details if empty
    if not message:
        if payload.get("tool_name") or payload.get("permission_request") or payload.get("permission"):
            perm = payload.get("permission")
            perm_name = perm.get("type") if isinstance(perm, dict) else perm
            tool_name = (
                payload.get("tool_name")
                or payload.get("permission_request", {}).get("tool")
                or perm_name
                or "Tool"
            )
            message = f"Approval needed: {tool_name}"
        elif payload.get("question") or payload.get("question_asked"):
            message = "Human input needed"
        elif payload.get("error") or payload.get("session_error") or payload.get("terminationReason") == "error":
            err = str(payload.get("error") or payload.get("session_error") or "Execution halted with error")
            message = err[:70]
        else:
            last_msg = payload.get("last_assistant_message", "")
            if not last_msg and conv_id:
                agy_tpath = os.path.expanduser(f"~/.gemini/antigravity-cli/brain/{conv_id}/.system_generated/logs/transcript.jsonl")
                if os.path.exists(agy_tpath):
                    try:
                        with open(agy_tpath, "r", encoding="utf-8", errors="ignore") as f:
                            for l in reversed(f.readlines()[-60:]):
                                d = json.loads(l)
                                if d.get("type") == "PLANNER_RESPONSE" and d.get("content"):
                                    last_msg = str(d["content"]).strip()
                                    break
                    except Exception:
                        pass
            if last_msg:
                clean_msg = re.sub(r"[\n\r]+", " ", last_msg).strip("#*` \t\r\n")[:70]
                message = clean_msg if clean_msg else "Task complete"
            else:
                message = "Task complete"

    # Detect agent name if empty
    if not agent_name:
        if payload.get("conversationId"):
            agent_name = "AGY"
        elif payload.get("turn_id") is not None or payload.get("type") == "agent-turn-complete":
            agent_name = "Codex"
        elif payload.get("transcript_path"):
            agent_name = "Claude Code"
        else:
            agent_name = "AI Agent"

    # Agent badges
    badge_map = {
        "codex": ("Codex", "🔵"),
        "claude": ("Claude Code", "🟠"),
        "claude code": ("Claude Code", "🟠"),
        "claudecode": ("Claude Code", "🟠"),
        "agy": ("AGY", "🟣"),
        "antigravity": ("AGY", "🟣"),
        "opencode": ("OpenCode", "🟢"),
        "cursor": ("Cursor", "⚡"),
    }
    canon_name, badge = badge_map.get(agent_name.lower(), (agent_name, "🤖"))

    # Resolve pane context
    ctx = resolve_notification_context(canon_name, payload, target_pane=target_pane)
    pane = ctx.get("pane", "")
    pane_location = ctx.get("location", "")
    is_focused = ctx.get("focused", False)
    pane_tty = ctx.get("pane_tty", "")
    client_tty = ctx.get("client_tty", "")

    host_name = platform.node().split(".")[0]
    notify_context = f"{host_name} · {pane_location}" if pane_location else host_name

    # Check configuration options
    mark_input = _tmux_option("@agent-switcher-mark-input", "on").lower()
    notify_mode = _tmux_option("@agent-switcher-notify", "none").lower()

    # Check if notification should be suppressed due to focus
    # When focused, suppress in-tmux yellow border, bell, and desktop banner unless forced.
    # Seeing a turn end is not answering it: leave the pane before replying and handle_focus_out raises the alert.
    if not force and is_focused:
        mark = _get_claude_last_turn_uuid(payload.get("transcript_path", ""))
        if pane and mark:
            pending = {"transcript_path": payload["transcript_path"], "mark": mark, "agent": canon_name, "message": message}
            try:
                subprocess.run(["tmux", "set", "-p", "-t", pane, "@pane-alert-pending", json.dumps(pending)], capture_output=True, timeout=0.2)
            except Exception:
                pass
        return

    # Apply In-Tmux visual mark (Layer 2)
    if mark_input == "on" and pane:
        try:
            subprocess.run(["tmux", "set", "-p", "-t", pane, "pane-border-style", "fg=yellow"], capture_output=True, timeout=0.2)
            subprocess.run(["tmux", "set", "-p", "-t", pane, "pane-active-border-style", "fg=yellow,bold"], capture_output=True, timeout=0.2)
            subprocess.run(["tmux", "set", "-p", "-t", pane, "@pane-needs-input", "1"], capture_output=True, timeout=0.2)
        except Exception:
            pass

    # Terminal bell
    if notify_mode in ("bell", "all") and pane_tty and os.path.exists(pane_tty):
        try:
            with open(pane_tty, "w") as pt:
                pt.write("\a")
        except Exception:
            pass

    # Check if system notification mode is enabled (Layer 3)
    if notify_mode in ("none", "off", "bell"):
        return

    # De-duplicate notifications on same pane within 3 seconds
    if pane and not force:
        try:
            last_epoch = subprocess.run(
                ["tmux", "show-option", "-pqv", "-t", pane, "@last-notify-epoch"],
                capture_output=True, text=True, timeout=0.2
            ).stdout.strip()
            now = time.time()
            if last_epoch and (now - float(last_epoch)) < 3.0:
                return
            subprocess.run(["tmux", "set", "-p", "-t", pane, "@last-notify-epoch", str(now)], capture_output=True, timeout=0.2)
        except Exception:
            pass

    safe_title = f"{badge} {canon_name}".replace('"', ' ').replace('\\', ' ')
    safe_msg = message.replace('"', ' ').replace('\\', ' ')
    safe_ctx = notify_context.replace('"', ' ').replace('\\', ' ')

    is_darwin = platform.system() == "Darwin"
    remote = ctx.get("remote_clients", [])

    # Local macOS notification, unless every attached client is remote
    sent_desktop = False
    if is_darwin and (ctx.get("local_client") or not remote) and notify_mode in ("desktop", "all"):
        script = f'display notification "{safe_msg}" with title "{safe_title}" subtitle "{safe_ctx}"'
        try:
            subprocess.Popen(["osascript", "-e", script], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            sent_desktop = True
        except Exception:
            pass

    # OSC 9 to every SSH client (the user may sit at either end), plus the local client in passthrough mode.
    # With no client resolved, the pane's own tty: its tmux forwards the wrapped alert if passthrough is allowed.
    targets = list(remote)
    if (notify_mode == "passthrough" or (notify_mode == "all" and not sent_desktop)) and client_tty not in [t for t, _ in remote]:
        targets.append((client_tty, ctx.get("client_term", "")) if client_tty else (pane_tty, "tmux"))
    for tty, term in targets:
        if tty and os.path.exists(tty):
            try:
                with open(tty, "w") as ct:
                    ct.write(_osc9(f"{safe_title} · {safe_ctx}: {safe_msg}", term))
            except Exception:
                pass


# --- CLI Entrypoints & Subcommand Dispatcher (cli.py) ---
"""Command-line interface and subcommand entrypoints for tmux-agent-switcher."""

def index_shared_state() -> Dict[str, Any]:
    """Pre-scan private databases and session indexes once per listing."""
    state: Dict[str, Any] = {
        "now": time.time(),
        "host": os.uname().nodename.split(".")[0],
        "home": os.path.expanduser("~"),
        "agy_titles": {}, "codex_threads": {}, "codex_cwd": {},
        "oc_sessions": [], "oc_db": None, "claude_idx": {}, "cc_status": {}
    }

    # AGY summaries
    agy_db = os.path.expanduser("~/.gemini/antigravity-cli/conversation_summaries.db")
    if os.path.exists(agy_db):
        try:
            with sqlite3.connect(f"file:{agy_db}?mode=ro", uri=True) as conn:
                for cid, title, idle in conn.execute("SELECT conversation_id, title, not_fully_idle FROM conversation_summaries"):
                    state["agy_titles"][cid] = (title, idle)
        except Exception:
            pass

    # Codex state
    codex_s = os.path.expanduser("~/.codex/state_5.sqlite")
    if os.path.exists(codex_s):
        try:
            with sqlite3.connect(f"file:{codex_s}?mode=ro", uri=True) as conn:
                for tid, name, u_ms, cwd in conn.execute("SELECT id, name, updated_at_ms, cwd FROM threads"):
                    if name:
                        state["codex_threads"][name.strip()] = (tid, (u_ms or 0) / 1000.0)
                    state["codex_cwd"][cwd] = max(state["codex_cwd"].get(cwd, 0.0), (u_ms or 0) / 1000.0)
        except Exception:
            pass

    # OpenCode state
    oc_path = os.path.expanduser("~/.local/share/opencode/opencode.db")
    if os.path.exists(oc_path):
        try:
            conn = sqlite3.connect(f"file:{oc_path}?mode=ro", uri=True)
            state["oc_db"] = conn
            state["oc_sessions"] = conn.execute("SELECT id, title, time_updated FROM session WHERE parent_id IS NULL").fetchall()
        except Exception:
            pass

    # Claude indices
    claude_paths = glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl"))
    state["claude_idx"] = {os.path.basename(p)[:-6]: p for p in claude_paths}
    state["cc_sessions"] = {}
    for f in glob.glob(os.path.expanduser("~/.claude*/sessions/*.json")):
        try:
            with open(f, "r", encoding="utf-8") as fh:
                d = json.load(fh)
            pid_s = str(d.get("pid", ""))
            state["cc_status"][pid_s] = d.get("status")
            state["cc_sessions"][pid_s] = d
        except Exception:
            pass

    return state

def cmd_list(args: argparse.Namespace) -> None:
    """Generate ANSI-styled, priority-sorted pane list for fzf."""
    tree = ProcessTree()
    panes = list_all_panes()
    state = index_shared_state()
    state.update({"tree": tree.tree, "cmd_of": tree.cmd_of, "my_pid": tree.my_pid})
    now = state["now"]
    out: List[Tuple[int, float, str]] = []

    for pane in panes:
        desc_cmd = tree.get_descendants(pane.pid)
        heads = tree.get_agent_heads(pane.pid)
        adapter = resolve_adapter(pane, desc_cmd, heads)
        harness, h_col, rank, mtime, title, running = adapter.get_status(pane, desc_cmd, heads, state)

        is_current = (pane.window_active == "1" and pane.pane_active == "1" and pane.session_attached != "0")
        is_monitor = (adapter.name == "system-monitor")
        status = "💤 idle"

        if running and (now - mtime < 1800):
            if isinstance(running, str) and running in ("🤖 subagent", "🐚 shell"):
                status = running
            else:
                status = "⚡ run"
            rank = 1

        if is_monitor:
            rank, age_str = 3, "LIVE"
        else:
            if not running and (rank == 0 or pane.pane_needs_input == "1" or (pane.bell_flag == "1" and pane.pane_active == "1")):
                status, rank = "🔔 input", 0

            if running and pane.pane_needs_input == "1":
                try:
                    subprocess.run(["tmux", "set", "-pu", "-t", pane.pane_id, "@pane-needs-input"], capture_output=True)
                    subprocess.run(["tmux", "set", "-pu", "-t", pane.pane_id, "pane-border-style"], capture_output=True)
                    subprocess.run(["tmux", "set", "-pu", "-t", pane.pane_id, "pane-active-border-style"], capture_output=True)
                except Exception:
                    pass

            if mtime:
                diff = max(0, int(now - mtime))
                if diff < 60:
                    age_str = f"{diff}s"
                elif diff < 3600:
                    age_str = f"{diff // 60}m"
                elif diff < 86400:
                    age_str = f"{diff // 3600}h"
                else:
                    age_str = f"{diff // 86400}d"
            else:
                age_str = " - "

        s_col = {
            "🔔 input": C_RED_BOLD, "⚡ run": C_GREEN_BOLD,
            "🤖 subagent": C_CYAN_BOLD, "🐚 shell": C_CYAN_BOLD
        }.get(status, C_DIM)

        mark = f"{C_GREEN_BOLD}▶{C_RESET}" if is_current else " "
        id_w = max((len(p.pane_id) for p in panes), default=8)
        id_w = max(id_w, 8)
        pad_id = f"{pane.pane_id:<{id_w}}"
        pad_h = pad_str(harness, 13)
        pad_s = pad_str(status, 10)
        formatted = (
            f"{pad_id} {mark} {h_col}{pad_h}{C_RESET} "
            f"{s_col}{pad_s}{C_RESET} {C_DIM}{age_str:>4}{C_RESET}  "
            f"{C_WHITE}{title[:60]}{C_RESET}"
        )
        out.append((rank, mtime, formatted))

    if state.get("oc_db"):
        try:
            state["oc_db"].close()
        except Exception:
            pass

    out.sort(key=lambda x: (x[0], -x[1]))
    for _, _, line in out:
        print(line)

def cmd_preview(args: argparse.Namespace) -> None:
    """Render preview dialogue bubbles or fallback terminal buffer for target pane."""
    if not args.pane_id:
        return
    pane = get_pane_context(args.pane_id)
    if not pane:
        return

    tree = ProcessTree(tty=pane.tty if pane.tty else None)
    desc_cmd = tree.get_descendants(pane.pid)
    desc_pids = tree.get_descendant_pids(pane.pid)
    heads = tree.get_agent_heads(pane.pid)

    full = "full history" in os.environ.get("FZF_PREVIEW_LABEL", "")
    w = int(os.environ.get("FZF_PREVIEW_COLUMNS") or 0)

    result: Optional[PreviewResult] = None
    matched_adapter = None
    for adapter in ADAPTERS:
        try:
            if adapter.detect(pane, desc_cmd, heads):
                if not matched_adapter:
                    matched_adapter = adapter
                result = adapter.get_preview(pane, desc_cmd, desc_pids, full, w)
                if result:
                    break
        except Exception:
            continue

    if not result:
        result = FallbackTuiAdapter().get_preview(pane, desc_cmd, desc_pids, full, w)

    if result and matched_adapter and matched_adapter.name != "fallback":
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        clean_t = re.sub(
            r"\s*-\s*(?:[⏳🧭⌨️📝🔄📋❓🔐✅📤📂]\s*)?(?:Working.*|Planning|Running shell.*|Reviewing.*|Reconnecting|Queued|Waiting for.*|Ready|Moving to cloud|Loading conversation)\s*$",
            "",
            disp_t
        ).strip()
        disp_t = clean_t if clean_t else disp_t
        result.source_label = f"{matched_adapter.display_name} · {disp_t or pane.pane_id}"

    if result:
        print(f"\033[1;36m━━━ {args.pane_id} · {result.source_label} ━━━\033[0m\n\n{result.content}")

def cmd_copy(args: argparse.Namespace) -> None:
    """Extract plain text preview and load into OSC 52 + system clipboard."""
    if not args.pane_id:
        return
    env = os.environ.copy()
    env["FZF_PREVIEW_COLUMNS"] = ""

    try:
        proc = subprocess.run(
            [sys.executable, sys.argv[0], "preview", args.pane_id],
            capture_output=True, text=True, env=env, check=False
        )
        raw = proc.stdout
    except Exception:
        raw = ""

    lines = raw.split("\n")
    content = "\n".join(lines[2:]) if len(lines) > 2 else raw
    content = re.sub(r'\033\[[0-9;]*m', '', content)
    content = re.sub(r'\033\]8;;[^\033]*\033\\', '', content)

    if not content.strip():
        try:
            content = subprocess.check_output(
                ["tmux", "capture-pane", "-pJ", "-S", "-100", "-t", args.pane_id]
            ).decode("utf-8", errors="ignore")
        except Exception:
            content = ""

    # Load into tmux buffer with OSC 52 flag (-w)
    try:
        subprocess.run(["tmux", "load-buffer", "-w", "-"], input=content.encode("utf-8"), check=False)
    except Exception:
        pass

    for tool in [["pbcopy"], ["wl-copy"], ["xclip", "-selection", "clipboard"]]:
        try:
            subprocess.run(tool, input=content.encode("utf-8"), check=True, stderr=subprocess.DEVNULL)
            break
        except Exception:
            continue

    try:
        subprocess.run(["tmux", "display-message", f"📋 Copied {args.pane_id} to system clipboard"], check=False)
    except Exception:
        pass

def cmd_run(args: argparse.Namespace) -> None:
    """Run interactive fzf switcher inside the popup."""
    self_path = os.path.abspath(sys.argv[0])
    pw = getattr(args, "preview_width", "58%") or "58%"

    fzf_cmd = (
        f"{self_path} list | fzf --ansi --reverse "
        f"--prompt='🔎 Agent Switcher > ' "
        f"--header='Enter: Jump | Tab: Preview | Ctrl-o: Full History | Shift-↑/↓ / Ctrl-u/d: Scroll | Ctrl-y: Copy (OSC 52) | Ctrl-x: Kill' "
        f"--preview-window 'right,{pw},border-left,wrap,follow' "
        f"--preview '{self_path} preview {{1}}' "
        f"--bind 'tab:toggle-preview' "
        f"--bind 'ctrl-o:transform-preview-label([ -n \"$FZF_PREVIEW_LABEL\" ] || echo \" full history \")+refresh-preview' "
        f"--bind 'focus:change-preview-label()' "
        f"--bind 'ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up' "
        f"--bind 'shift-up:preview-up,shift-down:preview-down' "
        f"--bind 'ctrl-b:preview-page-up,ctrl-f:preview-page-down' "
        f"--bind 'alt-up:preview-top,alt-down:preview-bottom' "
        f"--bind 'ctrl-y:execute-silent({self_path} copy {{1}})' "
        f"--bind 'alt-y:execute-silent(echo -n {{1}} | tmux load-buffer -w -; tmux display-message \"📋 Copied {{1}}\")' "
        f"--bind 'ctrl-x:execute(tmux kill-pane -t {{1}})+reload({self_path} list)' "
        f"| awk '{{print $1}}' | xargs -r tmux switch-client -t"
    )

    try:
        subprocess.run(["sh", "-c", fzf_cmd])
    except Exception:
        pass

def cmd_popup(args: argparse.Namespace) -> None:
    """Directly trigger tmux popup window."""
    self_path = os.path.abspath(sys.argv[0])
    w = getattr(args, "width", "88%") or "88%"
    h = getattr(args, "height", "82%") or "82%"
    pw = getattr(args, "preview_width", "58%") or "58%"

    subprocess.run([
        "tmux", "display-popup", "-w", w, "-h", h, "-E",
        f"{self_path} run --preview-width '{pw}'"
    ])

def read_stdin_payload(timeout: float = 0.05) -> str:
    """Read available payload from stdin without blocking indefinitely on unclosed pipes."""
    if sys.stdin.isatty():
        return ""
    try:
        import select
        chunks = []
        r, _, _ = select.select([sys.stdin], [], [], timeout)
        while r:
            chunk = os.read(sys.stdin.fileno(), 65536)
            if not chunk:
                break
            chunks.append(chunk)
            r, _, _ = select.select([sys.stdin], [], [], 0.005)
        return b"".join(chunks).decode("utf-8", errors="ignore")
    except Exception:
        return ""

def cmd_notify(args: argparse.Namespace) -> None:
    stdin_data = read_stdin_payload()
    handle_notify(
        agent_name=args.agent or "",
        message=args.message or "",
        target_pane=args.pane_id or "",
        force=args.force,
        stdin_data=stdin_data
    )
    print("{}")

def cmd_hook_title(args: argparse.Namespace) -> None:
    try:
        pane_id = args.pane_id or os.environ.get("TMUX_PANE", "")
        handle_hook_title(pane_id)
    except Exception:
        pass
    sys.exit(0)

def cmd_clear(args: argparse.Namespace) -> None:
    try:
        pane_id = args.pane_id or os.environ.get("TMUX_PANE", "")
        handle_clear(pane_id)
    except Exception:
        pass
    sys.exit(0)

def cmd_focus_out(args: argparse.Namespace) -> None:
    try:
        pane_id = args.pane_id or os.environ.get("TMUX_PANE", "")
        handle_focus_out(pane_id)
    except Exception:
        pass
    sys.exit(0)

def cmd_context(args: argparse.Namespace) -> None:
    raw = read_stdin_payload()
    payload = {}
    if raw:
        try:
            payload = json.loads(raw)
        except Exception:
            payload = {}
    ctx = resolve_notification_context(
        agent_name=args.agent or "",
        payload=payload,
        target_pane=args.pane_id or "",
        tag_session=getattr(args, "tag_session", False)
    )
    print(json.dumps(ctx))

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="tmux-agent-switcher",
        description="Unified multiplexing & dialogue preview center for AI coding agents in Tmux."
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("list", help="List and rank all active agents across panes")
    p_prev = sub.add_parser("preview", help="Render formatted preview for a pane")
    p_prev.add_argument("pane_id", help="Target tmux pane identifier (e.g. %%43)")

    p_copy = sub.add_parser("copy", help="Copy unwrapped dialogue to clipboard via OSC 52")
    p_copy.add_argument("pane_id", help="Target tmux pane identifier (e.g. %%43)")

    p_run = sub.add_parser("run", help="Run interactive fzf switcher pipeline")
    p_run.add_argument("--preview-width", default="58%", help="Preview panel width (default: 58%%)")

    p_pop = sub.add_parser("popup", help="Directly trigger tmux popup window")
    p_pop.add_argument("--width", default="88%", help="Popup width (default: 88%%)")
    p_pop.add_argument("--height", default="82%", help="Popup height (default: 82%%)")
    p_pop.add_argument("--preview-width", default="58%", help="Preview panel width (default: 58%%)")

    p_not = sub.add_parser("notify", help="Universal AI agent notification dispatcher")
    p_not.add_argument("agent", nargs="?", default="", help="Agent name (e.g. Claude, Cursor, AGY)")
    p_not.add_argument("message", nargs="?", default="", help="Notification message summary")
    p_not.add_argument("pane_id", nargs="?", default="", help="Target tmux pane identifier (e.g. %%43)")
    p_not.add_argument("-f", "--force", action="store_true", help="Force notification even if focused")

    p_hook = sub.add_parser("hook-title", help="Handle tmux pane-title-changed event")
    p_hook.add_argument("pane_id", nargs="?", default="", help="Target tmux pane identifier (e.g. %%43)")

    p_clr = sub.add_parser("clear", help="Clear visual yellow border and input alerts on pane")
    p_clr.add_argument("pane_id", nargs="?", default="", help="Target tmux pane identifier (e.g. %%43)")

    p_fo = sub.add_parser("focus-out", help="Raise an alert held back while the pane had focus")
    p_fo.add_argument("pane_id", nargs="?", default="", help="Target tmux pane identifier (e.g. %%43)")

    p_ctx = sub.add_parser("context", help="Resolve notification context for an agent")
    p_ctx.add_argument("agent", nargs="?", default="", help="Agent name")
    p_ctx.add_argument("pane_id", nargs="?", default="", help="Target tmux pane identifier")
    p_ctx.add_argument("--tag-session", action="store_true", help="Tag tmux pane with session metadata")

    args = parser.parse_args()
    dispatch = {
        "list": cmd_list, "preview": cmd_preview, "copy": cmd_copy,
        "run": cmd_run, "popup": cmd_popup, "notify": cmd_notify,
        "hook-title": cmd_hook_title, "clear": cmd_clear, "focus-out": cmd_focus_out, "context": cmd_context
    }
    if args.command in dispatch:
        dispatch[args.command](args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()

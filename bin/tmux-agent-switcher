# --- Configuration & Terminal ANSI Styling (core/config.py) ---
"""Terminal color palettes, ANSI escape codes, and display utilities."""

# Basic ANSI Controls
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_DIM = "\033[2m"
C_ITALIC = "\033[3m"
C_STRIKE = "\033[9m"

# Standard / High-Intensity Colors
C_RED_BOLD = "\033[1;31m"
C_GREEN_BOLD = "\033[1;32m"
C_CYAN_BOLD = "\033[1;36m"
C_WHITE = "\033[97m"
C_WHITE_BOLD = "\033[1;37m"

# 24-bit TrueColor Agent Palettes
C_AGY = "\033[1;38;2;78;136;245m"        # Google Gemini Spark Blue (#4E88F5)
C_CLAUDE = "\033[1;38;2;217;119;87m"     # Anthropic Terracotta Coral (#D97757)
C_CODEX = "\033[1;38;2;16;163;127m"      # OpenAI Emerald Teal (#10A37F)
C_CURSOR = "\033[1;38;2;226;232;240m"    # Cursor Titanium Silver (#E2E8F0)
C_GROK = "\033[1;38;2;240;240;245m"      # xAI Stark Monochrome (#F0F0F5)
C_CMD = "\033[1;38;2;6;182;212m"         # Command Code Cyan (#06B6D4)
C_OPENCODE = "\033[1;38;2;34;197;94m"    # OpenCode Vibrant Green (#22C55E)
C_OMP = "\033[1;38;2;167;139;250m"       # Oh My Pi Violet (#A78BFA)
C_MONITOR = "\033[38;2;148;163;184m"     # Telemetry Slate (#94A3B8)

# Dialogue Preview Palettes
C_ICE_BLUE = "\033[1;38;2;125;207;255m"
C_LAVENDER = "\033[1;38;2;187;154;247m"
C_MINT = "\033[38;2;158;206;106m"
C_PEACH = "\033[38;2;255;195;135m"
C_SLATE_BLUE = "\033[38;2;122;162;247m"
C_BORDER = "\033[38;2;86;95;137m"
C_DIVIDER = "\033[38;2;65;72;100m"
C_MUTED = "\033[38;2;140;145;170m"
C_LINK = "\033[4;38;2;125;207;255m"
C_TD = "\033[38;2;226;232;240m"

# Conversation Turn Bubble Styling
C_USER_BG = "\033[1;48;2;76;29;149;38;2;233;213;255m"
C_USER_TXT = "\033[1;38;2;243;232;255m"
C_ACTIVE_BG = "\033[1;48;2;120;53;15;38;2;254;240;138m"
C_ACTIVE_TXT = "\033[1;38;2;254;243;199m"
C_BAR_ACTIVE = "\033[38;2;245;158;11m"
C_BAR_USER = "\033[38;2;168;85;247m"

SHELLS = ("zsh", "-zsh", "bash", "sh", "fish")

def char_width(c: str) -> int:
    """Return monospace display width for a single character (handles CJK/emojis/symbols)."""
    if unicodedata.east_asian_width(c) in ("W", "F"):
        return 2
    cp = ord(c)
    if (0x1F300 <= cp <= 0x1FAFF or 0x2600 <= cp <= 0x27BF or
        0x1100 <= cp <= 0x115F or 0x2E80 <= cp <= 0xA4CF or
        0xAC00 <= cp <= 0xD7A3 or 0xF900 <= cp <= 0xFAFF or
        0xFE10 <= cp <= 0xFE19 or 0xFE30 <= cp <= 0xFE6F or
        0xFF00 <= cp <= 0xFF60 or 0xFFE0 <= cp <= 0xFFE6 or
        0x20000 <= cp <= 0x2FA1F):
        return 2
    return 1

def str_display_width(s: str) -> int:
    """Calculate terminal visual width of a string, ignoring ANSI and OSC sequences."""
    s_clean = re.sub(r'\033\]8;;[^\033]*\033\\', '', s)
    s_clean = re.sub(r'\033\[[0-9;]*[a-zA-Z]', '', s_clean)
    return sum(char_width(c) for c in s_clean)

def pad_str(s: str, target_width: int) -> str:
    """Pad string with trailing spaces to match target display width."""
    curr_w = str_display_width(s)
    pad = max(0, target_width - curr_w)
    return s + " " * pad


# --- Core Data Types (core/types.py) ---
"""Core data types and structures for Tmux Agent Switcher."""

@dataclass
class PaneContext:
    """Metadata of a single Tmux pane."""
    pane_id: str
    pid: str
    current_command: str
    title: str
    bell_flag: str = "0"
    pane_active: str = "0"
    window_active: str = "0"
    session_attached: str = "1"
    cwd: str = ""
    tty: str = ""
    width: str = ""
    height: str = ""
    claude_sid: str = ""
    agy_tag: str = ""
    cmd_code_sid: str = ""
    oc_tag: str = ""
    omp_tag: str = ""
    pane_needs_input: str = ""

@dataclass
class PreviewResult:
    """Formatted preview content for fzf right pane."""
    source_label: str
    content: str


# --- Process Tree & Tmux Introspection (core/tmux.py) ---
"""Tmux interface and process tree discovery utilities."""

OMP_PATTERN = r"(^|[\s/])omp(\s|$)"
AGENTS_REGEX = re.compile(r"cursor-agent|codex|command-code|claude|grok|agy|opencode|" + OMP_PATTERN)

class ProcessTree:
    """Snapshot of the operating system process tree."""

    def __init__(self, tty: Optional[str] = None):
        self.my_pid = str(os.getpid())
        self.tree: Dict[str, List[Tuple[str, str]]] = collections.defaultdict(list)
        self.cmd_of: Dict[str, str] = {}
        cmd = ["ps", "-t", tty, "-o", "pid,ppid,command"] if tty else ["ps", "-eo", "pid,ppid,command"]
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, check=False)
            for line in res.stdout.strip().splitlines()[1:]:
                parts = line.strip().split(None, 2)
                if len(parts) == 3:
                    self.tree[parts[1]].append((parts[0], parts[2]))
                    self.cmd_of[parts[0]] = parts[2]
        except Exception:
            pass

    def get_descendants(self, pid: str) -> str:
        """Collect command lines of all descendant processes under pid."""
        cmds, stack = [], [str(pid)]
        while stack:
            curr = stack.pop()
            for child_pid, child_cmd in self.tree.get(curr, []):
                if child_pid != self.my_pid:
                    cmds.append(child_cmd)
                    stack.append(child_pid)
        return " ".join(cmds)

    def get_descendant_pids(self, pid: str) -> List[str]:
        """Collect all descendant PIDs under pid."""
        pids, stack = [], [str(pid)]
        while stack:
            curr = stack.pop()
            for child_pid, _ in self.tree.get(curr, []):
                if child_pid != self.my_pid:
                    pids.append(child_pid)
                    stack.append(child_pid)
        return pids

    def get_agent_heads(self, pid: str) -> str:
        """Find the shallowest process whose command name matches an agent."""
        level = [str(pid)]
        while level:
            heads = " ".join(" ".join(self.cmd_of.get(p, "").split()[:2]) for p in level)
            if AGENTS_REGEX.search(heads):
                return heads
            level = [c for p in level for c, _ in self.tree.get(p, []) if c != self.my_pid]
        return ""

def list_all_panes() -> List[PaneContext]:
    """Fetch all panes across all sessions in a single tmux list-panes call."""
    fmt = (
        "#{session_name}:#{window_index}.#{pane_index}\t#{pane_pid}\t#{pane_current_command}\t"
        "#{pane_title}\t#{window_bell_flag}\t#{pane_active}\t#{window_active}\t#{@agy-session-id}\t"
        "#{@pane-needs-input}\t#{@command-code-session-id}\t#{@claude-session-id}\t#{pane_current_path}\t"
        "#{session_attached}\t#{@opencode-session-id}\t#{@omp-session-id}\t#{pane_tty}\t"
        "#{pane_width}\t#{pane_height}"
    )
    try:
        raw = subprocess.check_output(["tmux", "list-panes", "-a", "-F", fmt]).decode("utf-8", errors="ignore").splitlines()
    except Exception:
        return []

    panes = []
    for line in raw:
        if not line.strip():
            continue
        p = (line.split("\t") + [""] * 18)[:18]
        panes.append(PaneContext(
            pane_id=p[0], pid=p[1], current_command=p[2], title=p[3], bell_flag=p[4],
            pane_active=p[5], window_active=p[6], agy_tag=p[7].strip(), pane_needs_input=p[8].strip(),
            cmd_code_sid=p[9].strip(), claude_sid=p[10].strip(), cwd=p[11], session_attached=p[12] or "1",
            oc_tag=p[13].strip(), omp_tag=p[14].strip(), tty=p[15].strip(), width=p[16].strip(), height=p[17].strip()
        ))
    return panes

def get_pane_context(pane_id: str) -> Optional[PaneContext]:
    """Retrieve metadata for a specific target pane via tmux display-message."""
    fmt = (
        "#{pane_pid}\t#{pane_current_command}\t#{pane_title}\t#{pane_width}x#{pane_height}\t"
        "#{pane_tty}\t#{@claude-session-id}\t#{@command-code-session-id}\t#{@opencode-session-id}\t"
        "#{@omp-session-id}\t#{@agy-session-id}\t#{@pane-needs-input}\t#{pane_current_path}"
    )
    try:
        raw = (subprocess.check_output(["tmux", "display-message", "-p", "-t", pane_id, fmt])
               .decode("utf-8", errors="ignore").rstrip("\n").split("\t") + [""] * 12)[:12]
        geom = raw[3]
        w, h = geom.split("x") if "x" in geom else ("", "")
        return PaneContext(
            pane_id=pane_id, pid=raw[0], current_command=raw[1] or "shell", title=raw[2] or pane_id,
            width=w, height=h, tty=raw[4], claude_sid=raw[5], cmd_code_sid=raw[6],
            oc_tag=raw[7], omp_tag=raw[8], agy_tag=raw[9], pane_needs_input=raw[10], cwd=raw[11]
        )
    except Exception:
        return PaneContext(pane_id=pane_id, pid="", current_command="shell", title=pane_id)


# --- Unicode Table Renderer (formatters/table.py) ---
"""Unicode box-drawing table renderer for markdown tables."""

def render_table(rows: List[str], style_inline_fn) -> List[str]:
    """
    Render GFM-style markdown table rows into beautiful Unicode box-drawing tables.
    Accurately accounts for CJK double-width characters and inline styles.
    """
    if not rows:
        return []

    table_data = []
    for r in rows:
        cells = [c.strip() for c in r.strip().strip('|').split('|')]
        table_data.append(cells)

    if not table_data:
        return []

    header = table_data[0]
    data_rows = []
    for r in table_data[1:]:
        if all(re.match(r"^:?-+:?$", c) for c in r if c):
            continue
        data_rows.append(r)

    num_cols = max(len(r) for r in table_data)
    col_widths = [0] * num_cols

    for r in [header] + data_rows:
        for i, c in enumerate(r):
            if i < num_cols:
                col_widths[i] = max(col_widths[i], str_display_width(style_inline_fn(c)))

    col_widths = [max(w, 4) for w in col_widths]

    top = C_BORDER + "┌─" + "─┬─".join("─" * w for w in col_widths) + "─┐" + C_RESET
    mid = C_BORDER + "├─" + "─┼─".join("─" * w for w in col_widths) + "─┤" + C_RESET
    bot = C_BORDER + "└─" + "─┴─".join("─" * w for w in col_widths) + "─┘" + C_RESET

    res = [top]
    h_cells = []
    for i in range(num_cols):
        raw = header[i] if i < len(header) else ""
        styled = style_inline_fn(raw, C_ICE_BLUE)
        h_cells.append(pad_str(f"{C_ICE_BLUE}{styled}{C_RESET}", col_widths[i]))
    res.append(f"{C_BORDER}│{C_RESET} " + f" {C_BORDER}│{C_RESET} ".join(h_cells) + f" {C_BORDER}│{C_RESET}")
    res.append(mid)

    for r in data_rows:
        d_cells = []
        for i in range(num_cols):
            raw = r[i] if i < len(r) else ""
            styled = style_inline_fn(raw, C_TD)
            d_cells.append(pad_str(f"{C_TD}{styled}{C_RESET}", col_widths[i]))
        res.append(f"{C_BORDER}│{C_RESET} " + f" {C_BORDER}│{C_RESET} ".join(d_cells) + f" {C_BORDER}│{C_RESET}")

    res.append(bot)
    return res


# --- Markdown Syntax Styler (formatters/markdown.py) ---
"""Markdown parser and ANSI syntax highlighter."""

def wrap_text(text: str, width: int = 0, indent: int = 0) -> List[str]:
    """
    Pre-wrap text to preview width so continuation lines retain proper indent/rail.
    Protects spaces inside `code` and **bold** spans before wrapping.
    """
    effective_w = width or int(os.environ.get("FZF_PREVIEW_COLUMNS") or 0)
    if not effective_w or effective_w - indent < 20:
        return [text]

    protected = re.sub(
        r"`[^`]*`|\*\*[^*]*\*\*",
        lambda m: m.group(0).replace(" ", "\x00"),
        text
    )
    wrapped = textwrap.wrap(
        protected,
        effective_w - indent - 1,
        break_long_words=False,
        break_on_hyphens=False
    )
    return [l.replace("\x00", " ") for l in wrapped] or [text]

def style_inline(text: str, base_col: str = "") -> str:
    """Apply inline markdown ANSI formatting: code, links, bold, italic, strikethrough."""
    s = text
    code_tokens = []

    def save_code(m):
        code_tokens.append(f"{C_PEACH}{m.group(1)}{C_RESET}{base_col}")
        return f"\x00CODE_{len(code_tokens)-1}\x00"

    s = re.sub(r"`([^`]+)`", save_code, s)

    def render_link(m):
        txt, url = m.group(1), m.group(2)
        return f"\033]8;;{url}\033\\{C_LINK}{txt}{C_RESET}{base_col}\033]8;;\033\\"

    s = re.sub(r"\[([^\]]+)\]\((https?://[^\)]+|file://[^\)]+|/[^\)]+)\)", render_link, s)

    s = re.sub(r"\*\*\*([^\*]+?)\*\*\*", rf"{C_WHITE_BOLD}{C_ITALIC}\1{C_RESET}{base_col}", s)
    s = re.sub(r"___([^_]+?)___", rf"{C_WHITE_BOLD}{C_ITALIC}\1{C_RESET}{base_col}", s)
    s = re.sub(r"\*\*([^\*]+?)\*\*", rf"{C_WHITE_BOLD}\1{C_RESET}{base_col}", s)
    s = re.sub(r"(?<!\w)__([^_]+?)__(?!\w)", rf"{C_WHITE_BOLD}\1{C_RESET}{base_col}", s)
    s = re.sub(r"(?<!\*)\*([^\*\s][^\*]*?[^\*\s]|[^\*\s])\*(?!\*)", rf"{C_ITALIC}\1{C_RESET}{base_col}", s)
    s = re.sub(r"(?<!\w)_([^_\s][^_]*?[^_\s]|[^_\s])_(?!\w)", rf"{C_ITALIC}\1{C_RESET}{base_col}", s)
    s = re.sub(r"~~([^~]+?)~~", rf"{C_STRIKE}{C_MUTED}\1{C_RESET}{base_col}", s)

    for i, tok in enumerate(code_tokens):
        s = s.replace(f"\x00CODE_{i}\x00", tok)
    return s

def render_md(text: str, preview_width: int = 0) -> str:
    """Render block Markdown to richly styled ANSI terminal output."""
    out = []
    in_code = False
    table_buf: List[str] = []

    def flush_table():
        nonlocal table_buf
        if table_buf:
            out.extend(render_table(table_buf, style_inline))
            table_buf = []

    for line in text.split("\n"):
        if line.strip().startswith("```"):
            flush_table()
            in_code = not in_code
            lang = line.strip().lstrip("`")
            out.append(
                f"{C_BORDER}─── {lang or 'code'} ──────────────────────────────────────────{C_RESET}"
                if in_code else f"{C_BORDER}{'─' * 50}{C_RESET}"
            )
            continue

        if in_code:
            out.append(f"  {C_MINT}{line}{C_RESET}")
            continue

        if line.strip().startswith("|") and line.strip().endswith("|"):
            table_buf.append(line.strip())
            continue
        else:
            flush_table()

        m_hdr = re.match(r"^(#{1,6})\s*(.+)$", line)
        if m_hdr:
            lvl = len(m_hdr.group(1))
            body = style_inline(m_hdr.group(2).strip().rstrip("#").strip())
            if lvl == 1:
                out.append(f"\n{C_ICE_BLUE}{C_BOLD}✦ {body}{C_RESET}")
            elif lvl == 2:
                out.append(f"\n{C_ICE_BLUE}{C_BOLD}■ {body}{C_RESET}")
            elif lvl == 3:
                out.append(f"\n{C_SLATE_BLUE}{C_BOLD}▲ {body}{C_RESET}")
            else:
                out.append(f"\n{C_MINT}{C_BOLD}▸ {body}{C_RESET}")
            continue

        if line.strip().startswith(">"):
            for q in wrap_text(line.strip().lstrip("> "), preview_width, 4):
                out.append(f"  {C_BORDER}│{C_RESET} {C_MUTED}{C_ITALIC}{style_inline(q, C_MUTED)}{C_RESET}")
            continue

        m_task = re.match(r"^(\s*)[\*\-\+]\s+\[([ xX])\]\s+(.*)$", line)
        if m_task:
            indent = m_task.group(1)
            checked = m_task.group(2).lower() == 'x'
            badge = f"{C_MINT}☑{C_RESET}" if checked else f"{C_MUTED}☐{C_RESET}"
            for i, b in enumerate(wrap_text(m_task.group(3), preview_width, len(indent) + 2)):
                out.append(f"{indent}{badge if i == 0 else ' '} {style_inline(b)}")
            continue

        if re.match(r"^\s*[\*\-\•]\s+", line):
            indent = len(line) - len(line.lstrip())
            body = re.sub(r"^\s*[\*\-\•]\s+", "", line)
            for i, b in enumerate(wrap_text(body, preview_width, indent + 2)):
                out.append(" " * indent + (f"{C_SLATE_BLUE}•{C_RESET} " if i == 0 else "  ") + style_inline(b))
            continue

        m_num = re.match(r"^(\s*\d+\.\s+)(.+)$", line)
        if m_num:
            p = m_num.group(1)
            for i, b in enumerate(wrap_text(m_num.group(2), preview_width, len(p))):
                out.append((f"{C_ICE_BLUE}{p}{C_RESET}" if i == 0 else " " * len(p)) + style_inline(b))
            continue

        if re.match(r"^(\-{3,}|\_{3,}|\*{3,})$", line.strip()):
            out.append(f"{C_DIVIDER}─────────────────────────────────────────────────────────────────{C_RESET}")
            continue

        lead = len(line) - len(line.lstrip())
        for b in wrap_text(line.strip(), preview_width, lead):
            out.append(" " * lead + style_inline(b))

    flush_table()
    return "\n".join(out)


# --- Terminal Screen De-Noiser (formatters/denoiser.py) ---
"""Terminal output semantic de-noiser."""

DENOISE_PATTERNS = [
    r"^.*(?:Token Monitor|AI Ledger|Shift\+Tab|Ctrl\+\.|\b\d+x\d+\b|\d+K\s*/\s*\d+K).*$",
    r"^.*(?:always-approve|Worked for \d+|［hooks：|\bhooks:\b).*$",
    r"^[│┌┐└┘├┤┬┴┼━┃┏┓┗┛┣┫┳┻╋═║╔╗╚╝╠╣╦╩╬╭╮╯╰─\s]+$",
    r"^[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+.*$",
    r"^\s*[L•]\s*$",
    r"^\s*\d+:\d+\s*(?:AM|PM)?\s*$",
    r"^.*(?:<truncated \d+ bytes>|truncated \d+ bytes).*$",
    r"^.*(?:Transfer-Encoding:\s*chunked|\bchunked\s+\d+\s*bytes\b).*$",
]
COMBINED_DENOISE_RE = re.compile("|".join(f"(?:{p})" for p in DENOISE_PATTERNS), re.IGNORECASE)

def denoise_terminal_text(text: str) -> str:
    """
    Filter raw terminal screen captures into clean, readable text.
    Strips noise like spinners, status bars, timestamps, shell prompt indicators,
    and orphan border characters.
    """
    lines = []
    for l in text.split("\n"):
        line = l.rstrip()
        if not line.strip():
            if lines and lines[-1]:
                lines.append("")
            continue
        if COMBINED_DENOISE_RE.match(line):
            continue
        clean_l = re.sub(r"^[〉❯>›]\s*", "", line)
        lines.append(clean_l)

    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and not lines[-1].strip():
        lines.pop()

    return "\n".join(lines)


# --- Dialogue Turn Bubbles (formatters/bubbles.py) ---
"""Conversational turn bubble formatter for preview panel."""

def format_turns(
    turns: List[Dict[str, str]],
    live: bool = True,
    full_history: Optional[bool] = None,
    preview_width: int = 0
) -> str:
    """
    Format conversational turns into styled bubbles.
    - User turns: styled pills with rounded left-rail box.
    - Assistant turns: markdown rendered with tables and syntax highlighting.
    - Live indicator: indicates actively running turn if unanswered.
    """
    if full_history is None:
        full_history = "full history" in os.environ.get("FZF_PREVIEW_LABEL", "")

    effective_w = preview_width or int(os.environ.get("FZF_PREVIEW_COLUMNS") or 0)
    parts = []
    total = len(turns)

    for i, t in enumerate(turns):
        u, a = t.get("user", "").strip(), t.get("assistant", "").strip()
        is_latest = (i == total - 1)
        turn_num = i + 1
        turn_badge = f"{C_DIVIDER}─── ✦ Turn {turn_num} of {total} ──────────────────────────────────────{C_RESET}"
        turn_parts = [turn_badge]

        if u:
            is_active = is_latest and not a and live
            pill = f"{C_ACTIVE_BG} ⚡ YOU (Active) {C_RESET}" if is_active else f"{C_USER_BG} 👤 YOU {C_RESET}"
            txt_col = C_ACTIVE_TXT if is_active else C_USER_TXT
            bar_col = C_BAR_ACTIVE if is_active else C_BAR_USER

            u_lines = [w for ul in u.split("\n") for w in wrap_text(ul, effective_w, 4)]
            if len(u_lines) > 12 and not full_history:
                u_lines = u_lines[:12] + [f"{C_MUTED}… +{len(u_lines) - 12} more lines{C_RESET}"]

            user_box = [f"{pill}"]
            for ul in u_lines:
                user_box.append(f"  {bar_col}│{C_RESET} {txt_col}{ul}{C_RESET}")
            user_box.append(f"  {bar_col}└──{C_RESET}")
            turn_parts.append("\n".join(user_box))

        if a:
            turn_parts.append(render_md(a, effective_w))
        elif is_latest and u and live:
            turn_parts.append(f"\n  \033[1;33m⚡ Agent is actively running...\033[0m\n")

        parts.append("\n\n".join(turn_parts))

    if full_history:
        parts.append(f"{C_DIVIDER}── 📜 full history · {total} turns · ctrl-o: recent only ──{C_RESET}")
    elif total >= 4:
        parts.append(f"{C_DIVIDER}── last {total} turns · ctrl-o: full history ──{C_RESET}")

    return "\n\n".join(parts)


# --- Agent Adapter Interface & Duck Parsing (adapters/base.py) ---
"""Base interface and parsing utilities for AI Agent adapters."""

def read_tail_lines(filepath: str, max_bytes: int = 800000, full: bool = False) -> List[str]:
    """
    Read tail lines from file without loading entire multi-gigabyte logs into RAM.
    If full is True, reads the entire file.
    """
    if not filepath or not os.path.exists(filepath):
        return []
    try:
        size = os.path.getsize(filepath)
        start = 0 if full else max(0, size - max_bytes)
        with open(filepath, "rb") as f:
            f.seek(start)
            raw = f.read().decode("utf-8", errors="ignore").strip().split("\n")
            return raw[1:] if start and len(raw) > 1 else raw
    except Exception:
        return []

def get_real_dialogue_time(filepath: str, max_bytes: int = 250000) -> float:
    """
    Extract the real timestamp of the most recent human prompt or agent reply.
    Avoids using raw mtime when loggers/watchdogs touch the file passively.
    """
    if not filepath or not os.path.exists(filepath):
        return 0.0
    try:
        size = os.path.getsize(filepath)
        with open(filepath, "rb") as f:
            f.seek(max(0, size - max_bytes))
            lines = f.read().decode("utf-8", errors="ignore").splitlines()
        for l in reversed(lines):
            try:
                d = json.loads(l)
                t = d.get("type", "")
                r = d.get("message", {}).get("role", "") if isinstance(d.get("message"), dict) else d.get("role", "")
                if t in ("user", "assistant", "USER_INPUT", "PLANNER_RESPONSE") or r in ("user", "assistant", "human", "model"):
                    ts = d.get("timestamp") or d.get("created_at")
                    if ts:
                        if isinstance(ts, (int, float)):
                            return ts / 1000.0 if ts > 1e11 else float(ts)
                        return datetime.datetime.fromisoformat(str(ts).replace("Z", "+00:00")).timestamp()
            except Exception:
                pass
        return os.path.getmtime(filepath)
    except Exception:
        return 0.0

def extract_duck_turns(lines: List[str], full: bool = False) -> List[Dict[str, str]]:
    """
    Duck-typing turn extractor supporting multiple schemas across Claude, AGY,
    Codex, Cursor, Grok, Command Code, and OMP.
    """
    turns: List[Dict[str, str]] = []
    curr = {"user": "", "assistant": ""}
    user_tags = {"user", "human", "usermessage", "user_input", "user_prompt"}
    asst_tags = {"assistant", "agent", "model", "agentmessage", "planner_response"}

    def extract_text(val: Any) -> str:
        if not val:
            return ""
        if isinstance(val, str):
            return val
        if isinstance(val, list):
            res = []
            for item in val:
                if isinstance(item, str):
                    res.append(item)
                elif isinstance(item, dict):
                    if item.get("type") == "text" and item.get("text"):
                        res.append(item["text"])
                    elif "text" in item and isinstance(item["text"], str):
                        res.append(item["text"])
                    elif "content" in item:
                        res.append(extract_text(item["content"]))
            return "\n".join(res)
        if isinstance(val, dict):
            return val.get("text") or extract_text(val.get("content")) or ""
        return str(val)

    for l in reversed(lines):
        if not l.strip():
            continue
        try:
            d = json.loads(l)
        except Exception:
            continue
        if not isinstance(d, dict) or d.get("isMeta") or d.get("isCompactSummary"):
            continue

        msg = d.get("message") if isinstance(d.get("message"), dict) else d
        role = (msg.get("role") or d.get("type") or msg.get("type") or "").lower()
        raw_c = msg.get("content") or d.get("content") or msg.get("text") or d.get("text")

        # Claude tool results are stored with role="user" but contain tool_result items
        if isinstance(raw_c, list) and any(isinstance(x, dict) and x.get("type") == "tool_result" for x in raw_c):
            continue

        text = extract_text(raw_c)
        if text.lstrip().startswith(("<command-", "<local-command-")):
            continue

        text = re.sub(r"<(ADDITIONAL_METADATA|system-reminder)>.*?</\1>", "", text, flags=re.DOTALL)
        text = re.sub(r"\s*📒 Possibly-relevant notes.*", "", text, flags=re.DOTALL)
        text = re.sub(r"\x1b\[[0-9;]*[A-Za-z]|</?[a-zA-Z0-9_-]+>", "", text).strip()

        if role in asst_tags and not curr["assistant"]:
            if text:
                curr["assistant"] = text
        elif role in user_tags:
            if text:
                curr["user"] = text
                if curr["assistant"] or curr["user"]:
                    turns.append(curr)
                    curr = {"user": "", "assistant": ""}
                    if len(turns) >= 4 and not full:
                        break

    if curr["assistant"]:
        turns.append(curr)

    turns.reverse()
    return turns

class BaseAgentAdapter:
    """Base class for agent detection, status tracking, and preview rendering."""

    name: str = "base"
    display_name: str = "Base"
    color: str = C_DIM

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        """Return True if this adapter handles the given pane."""
        raise NotImplementedError

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        """
        Extract list view status for this pane.
        Returns:
            (harness_label, harness_color, rank, mtime, title, is_running)
        """
        raise NotImplementedError

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        """
        Extract preview content for this pane.
        Returns PreviewResult or None if unhandled.
        """
        raise NotImplementedError


# --- OSC 7501 Protocol Adapter Stub (adapters/osc_7501.py) ---
"""
OSC 7501 Program Status Protocol Adapter (Forward-Looking Stub).
Specification: https://mitchellh.com/writing/program-status-osc7501

OSC 7501 is the emerging terminal multiplexer protocol for autonomous AI agents
to stream structured state machines directly over terminal escape sequences:
    \033]7501;state=running;agent=claude;sid=<uuid>;turn=3\033\\

This adapter establishes the standard protocol bridge, allowing future terminal agents
implementing OSC 7501 to bypass heuristic disk scraping (JSONL/SQLite) and register
zero-latency semantic lifecycle events natively.
"""

class Osc7501Adapter(BaseAgentAdapter):
    name = "osc-7501"
    display_name = "⚡ OSC 7501"
    color = C_CYAN_BOLD

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        # Activated when tmux pane option @osc-7501-state or environmental signal exists
        return False

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        return self.display_name, self.color, 2, 0.0, pane.title, False

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        return None


# --- Cursor Adapter (adapters/cursor.py) ---
"""Cursor agent adapter."""

class CursorAdapter(BaseAgentAdapter):
    name = "cursor"
    display_name = "⚡ Cursor"
    color = C_CURSOR

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return "cursor-agent" in heads or "cursor-agent" in pane.current_command or "cursor-agent" in full_desc

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        t_files = glob.glob(os.path.expanduser("~/.cursor/projects/*/agent-transcripts/*/*.jsonl"))
        w_files = glob.glob(os.path.expanduser("~/.cursor/projects/**/worker.log"), recursive=True)
        mtime = max((os.path.getmtime(f) for f in (t_files + w_files)), default=0.0)

        # Prefer project-specific mtime if pane.cwd matches a known project
        proj_transcripts: List[str] = []
        if pane.cwd:
            encoded = pane.cwd.strip("/").replace("/", "-")
            proj_transcripts = glob.glob(os.path.expanduser(f"~/.cursor/projects/{encoded}/agent-transcripts/*/*.jsonl"))
            proj_logs = glob.glob(os.path.expanduser(f"~/.cursor/projects/{encoded}/**/worker.log"), recursive=True)
            if proj_transcripts or proj_logs:
                mtime = max((os.path.getmtime(f) for f in (proj_transcripts + proj_logs)), default=0.0)

        raw_title = pane.title or ""
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", raw_title).strip()

        # Detect Cursor lifecycle state from OSC terminal title
        # Cursor CLI broadcasts: "[Chat] - ⏳ Working ...", "[Chat] - 🧭 Planning",
        #                        "[Chat] - ❓ Waiting for you", "[Chat] - ✅ Ready"
        is_running = bool(re.search(
            r"(?:Working|Planning|Running shell|Moving to cloud|Loading conversation|Reviewing changes|Reconnecting)",
            raw_title,
            re.IGNORECASE
        ))
        is_input = bool(re.search(r"(?:Waiting for you|Waiting for confirmation)", raw_title, re.IGNORECASE))

        # If not already flagged running by title, inspect terminal buffer & transcripts
        # to catch active execution (Thinking / ctrl+c to stop) or interactive choice questions
        if not is_running:
            screen = ""
            try:
                screen = subprocess.run(
                    ["tmux", "capture-pane", "-pJ", "-S", "-25", "-t", pane.pane_id],
                    capture_output=True,
                    text=True,
                    timeout=0.25
                ).stdout or ""
            except Exception:
                pass

            if screen:
                # 0. Active execution / thinking state probe on screen (overrides delayed OSC title)
                running_on_screen = bool(re.search(
                    r"(?:(?:[⠀-⣿⠋-]|\b)\s*Thinking\b|ctrl\+c\s+to\s+stop|Esc\s+to\s+cancel|\bGenerating\b|\bExecuting\s+command\b)",
                    screen,
                    re.IGNORECASE
                ))
                if running_on_screen:
                    is_running = True
                    is_input = False
                elif not is_input:
                    # 1. Interactive choice / question box (Ink / React CLI UI)
                    # Matches navigation footer: "Space select · Enter next/submit · Esc to skip" or "Enter select · Esc skip"
                    question_ui = bool(re.search(
                        r"(?:Space select|Enter next/submit|Esc to skip|Enter select · Esc skip)",
                        screen,
                        re.IGNORECASE
                    ))
                    question_body = bool(
                        re.search(r"Question \d+ of \d+", screen, re.IGNORECASE) and
                        re.search(r"›\s*\[[ x]\]", screen)
                    )
                    # 2. Tool / command execution approval prompt
                    approval_prompt = bool(re.search(
                        r"(?:Allow this command|Do you want to run|Allow once|Always allow|Allow \[y/n\]|Run command\?|Approve execution)",
                        screen,
                        re.IGNORECASE
                    ))

                    if question_ui or question_body or approval_prompt:
                        is_input = True
                    else:
                        # 3. Check active transcript if short ID found on screen or via project
                        target_transcripts = proj_transcripts
                        if not target_transcripts:
                            short_ids = set(re.findall(r"(?:·|›)\s*([0-9a-f]{8})\s*(?:·|›)", screen))
                            if short_ids:
                                target_transcripts = [tf for tf in t_files if os.path.basename(tf)[:8] in short_ids]

                        if target_transcripts:
                            latest_tf = max(target_transcripts, key=os.path.getmtime)
                            last_lines = read_tail_lines(latest_tf, max_bytes=4096, full=False)
                            if last_lines:
                                last_line = last_lines[-1]
                                if '"AskQuestion"' in last_line and '"turn_ended"' not in last_line:
                                    is_input = True

        # Strip trailing status indicator from display title
        clean_t = re.sub(
            r"\s*-\s*(?:[⏳🧭⌨️📝🔄📋❓🔐✅📤📂]\s*)?(?:Working.*|Planning|Running shell.*|Reviewing.*|Reconnecting|Queued|Waiting for.*|Ready|Moving to cloud|Loading conversation)\s*$",
            "",
            disp_t
        ).strip()
        disp_t = clean_t if clean_t else disp_t

        rank = 2
        running = False
        if is_running:
            rank = 1
            running = True
            mtime = max(mtime, time.time())
        elif is_input:
            rank = 0

        return self.display_name, self.color, rank, mtime, disp_t, running

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        clean_t = re.sub(
            r"\s*-\s*(?:[⏳🧭⌨️📝🔄📋❓🔐✅📤📂]\s*)?(?:Working.*|Planning|Running shell.*|Reviewing.*|Reconnecting|Queued|Waiting for.*|Ready|Moving to cloud|Loading conversation)\s*$",
            "",
            disp_t
        ).strip()
        disp_t = clean_t if clean_t else disp_t
        try:
            pane_pids = {str(pane.pid), *desc_pids}
            cursor_pids = []
            ps_out = subprocess.run(["ps", "-eo", "pid,ppid,command"], capture_output=True).stdout.decode().splitlines()
            for line in ps_out[1:]:
                proc = line.strip().split(None, 2)
                if len(proc) == 3 and proc[0] in pane_pids and re.search(r"(?:^|[ /])cursor-agent(?:\s|$)", proc[2]):
                    cursor_pids.append(proc[0])

            session_ids = set()
            lsof = shutil.which("lsof")
            if cursor_pids and lsof:
                opened = subprocess.run(
                    [lsof, "-a", "-p", ",".join(cursor_pids), "-Fn"],
                    capture_output=True,
                    timeout=1
                ).stdout.decode(errors="replace")
                session_ids = set(re.findall(r"/\.cursor/chats/[^/]+/([0-9a-f-]{36})/store\.db(?:$|[-\n])", opened, re.MULTILINE))

            sid = next(iter(session_ids)) if len(session_ids) == 1 else ""
            if not sid:
                try:
                    screen = subprocess.check_output(
                        ["tmux", "capture-pane", "-pJ", "-S", "-20", "-t", pane.pane_id]
                    ).decode()
                    short_ids = set(re.findall(r"(?:·|›)\s*([0-9a-f]{8})\s*(?:·|›)", screen))
                    candidates = session_ids or {
                        os.path.basename(p)[:-6]
                        for p in glob.glob(os.path.expanduser("~/.cursor/projects/*/agent-transcripts/*/*.jsonl"))
                    }
                    matched = {s for s in candidates if s[:8] in short_ids}
                    if len(matched) == 1:
                        sid = next(iter(matched))
                except Exception:
                    pass

            if not sid and pane.cwd:
                encoded = pane.cwd.strip("/").replace("/", "-")
                proj_matches = glob.glob(os.path.expanduser(f"~/.cursor/projects/{encoded}/agent-transcripts/*/*.jsonl"))
                if proj_matches:
                    latest_proj = max(proj_matches, key=os.path.getmtime)
                    sid = os.path.basename(latest_proj)[:-6]

            matches = glob.glob(os.path.expanduser(f"~/.cursor/projects/*/agent-transcripts/{sid}/{sid}.jsonl")) if sid else []
            if matches:
                transcript = max(matches, key=os.path.getmtime)
                records = []
                for line in read_tail_lines(transcript, full=full_history):
                    try:
                        record = json.loads(line)
                    except Exception:
                        continue
                    role = record.get("role")
                    if role not in ("user", "assistant"):
                        continue
                    parts = record.get("message", {}).get("content", [])
                    text = "\n".join(p.get("text", "") for p in parts if isinstance(p, dict) and p.get("type") == "text")
                    if role == "user":
                        query = re.search(r"<user_query>(.*?)</user_query>", text, re.DOTALL)
                        text = query.group(1).strip() if query else re.sub(r"<timestamp>.*?</timestamp>", "", text, flags=re.DOTALL)
                    records.append(json.dumps({"role": role, "content": text}))

                turns = extract_duck_turns(records, full=full_history)
                if turns:
                    is_live = False
                    try:
                        is_live = time.time() - os.path.getmtime(transcript) < 120
                    except Exception:
                        pass
                    content = format_turns(turns, live=is_live, full_history=full_history, preview_width=preview_width)
                    return PreviewResult(
                        source_label=f"{self.display_name} · {disp_t} · {sid[:8]}",
                        content=content
                    )
        except Exception:
            pass
        return None


# --- OpenAI Codex Adapter (adapters/codex.py) ---
"""OpenAI Codex adapter."""

class CodexAdapter(BaseAgentAdapter):
    name = "codex"
    display_name = "⚡ Codex"
    color = C_CODEX

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return "codex" in heads or "codex" in full_desc or "@openai/codex" in full_desc

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        codex_threads = shared_state.get("codex_threads", {})
        codex_cwd = shared_state.get("codex_cwd", {})

        spinning = bool(re.match(r"\s*[⠀-⣿]", pane.title))
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        clean_t = disp_t.split("|")[0].strip("[]* ")

        mtime = 0.0
        for k, (tid, u_time) in codex_threads.items():
            if k == clean_t or k in clean_t or clean_t in k:
                mtime = max(mtime, u_time)

        mtime = mtime or codex_cwd.get(pane.cwd, 0.0)

        status = "💤 idle"
        rank = 2
        running = False
        if spinning:
            status = "⚡ run"
            rank = 1
            running = True

        return self.display_name, self.color, rank, mtime, disp_t, running

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        clean_t = disp_t.split("|")[0].strip("[]* ")

        s_db = os.path.expanduser("~/.codex/state_5.sqlite")
        h_db = os.path.expanduser("~/.codex/thread_history_1.sqlite")

        if os.path.exists(s_db) and os.path.exists(h_db):
            try:
                conn_s = sqlite3.connect(f"file:{s_db}?mode=ro", uri=True)
                row = conn_s.execute(
                    'SELECT id, name FROM threads WHERE name = ? OR name LIKE ? OR ? LIKE "%" || name || "%" ORDER BY updated_at_ms DESC LIMIT 1',
                    (clean_t, f"%{clean_t}%", clean_t)
                ).fetchone()
                conn_s.close()

                if row:
                    tid, _ = row
                    conn_h = sqlite3.connect(f"file:{h_db}?mode=ro", uri=True)
                    items = conn_h.execute(
                        'SELECT item_type, item_json FROM thread_items WHERE thread_id = ? AND item_type IN ("userMessage", "agentMessage") ORDER BY created_at_ms DESC LIMIT ?',
                        (tid, -1 if full_history else 15)
                    ).fetchall()
                    conn_h.close()

                    raw_records = []
                    for itype, ijson in items:
                        try:
                            d = json.loads(ijson)
                        except Exception:
                            continue
                        r = "assistant" if itype == "agentMessage" else "user"
                        raw_records.append(json.dumps({"role": r, "content": d.get("content") or d.get("text")}))

                    turns = extract_duck_turns(raw_records, full=full_history)
                    if turns:
                        content = format_turns(turns, live=True, full_history=full_history, preview_width=preview_width)
                        return PreviewResult(
                            source_label=f"{self.display_name} · {disp_t}",
                            content=content
                        )
            except Exception:
                pass
        return None


# --- Command Code Adapter (adapters/command_code.py) ---
"""Command Code adapter."""

class CommandCodeAdapter(BaseAgentAdapter):
    name = "command-code"
    display_name = "⚡ Cmd"
    color = C_CMD

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return "command-code" in heads or bool(pane.cmd_code_sid) or "command-code" in full_desc

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        mtime = 0.0
        if pane.cmd_code_sid:
            c_files = glob.glob(os.path.expanduser(f"~/.commandcode/projects/**/{pane.cmd_code_sid}*.jsonl"), recursive=True)
            if c_files:
                mtime = get_real_dialogue_time(c_files[0])
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        return self.display_name, self.color, 2, mtime, disp_t, False

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        if pane.cmd_code_sid and not ("codex" in full_desc or "@openai/codex" in full_desc):
            c_files = glob.glob(os.path.expanduser(f"~/.commandcode/projects/**/{pane.cmd_code_sid}*.jsonl"), recursive=True)
            if c_files:
                lines = read_tail_lines(c_files[0], full=full_history)
                turns = extract_duck_turns(lines, full=full_history)
                if turns:
                    content = format_turns(turns, live=True, full_history=full_history, preview_width=preview_width)
                    return PreviewResult(
                        source_label=f"{self.display_name} · {disp_t}",
                        content=content
                    )
        return None


# --- Anthropic Claude Code Adapter (adapters/claude.py) ---
"""Anthropic Claude Code adapter."""

def claude_state(fpath: str, max_bytes: int = 250000) -> Tuple[float, bool]:
    """
    Determine last dialogue timestamp and whether the turn is still open.
    A finished turn ends in stop_hook_summary or turn_duration.
    """
    try:
        with open(fpath, "rb") as f:
            f.seek(max(0, os.path.getsize(fpath) - max_bytes))
            lines = f.read().decode("utf-8", errors="ignore").splitlines()
    except Exception:
        return 0.0, False

    ended = False
    for l in reversed(lines):
        try:
            d = json.loads(l)
        except Exception:
            continue
        if not isinstance(d, dict):
            continue
        t = d.get("type")
        if t == "system" and d.get("subtype") in ("stop_hook_summary", "turn_duration"):
            ended = True
        if t not in ("user", "assistant") or not d.get("timestamp"):
            continue
        ts = datetime.datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00")).timestamp()
        m = d.get("message") or {}
        c = json.dumps(m.get("content"))
        if ended or d.get("isMeta") or "[Request interrupted" in c or c.startswith(("\"<command-", "\"<local-command-")):
            return ts, False
        return ts, t == "user" or m.get("stop_reason") in (None, "tool_use")

    try:
        return os.path.getmtime(fpath), False
    except Exception:
        return 0.0, False

def resolve_session_chain(sid: str, claude_idx: Dict[str, str]) -> str:
    """Follow continued-in session pointers to find the tip of the conversation."""
    seen = {sid}
    curr = sid
    while curr in claude_idx:
        p = claude_idx[curr]
        next_sid = None
        try:
            with open(p, "rb") as f:
                f.seek(max(0, os.path.getsize(p) - 8192))
                lines = f.read().decode("utf-8", errors="ignore").splitlines()
            for l in reversed(lines):
                if '"continued-in"' in l:
                    try:
                        d = json.loads(l)
                        if d.get("type") == "continued-in" and d.get("continuedInSessionId"):
                            next_sid = d["continuedInSessionId"]
                            break
                    except Exception:
                        pass
        except Exception:
            pass
        if next_sid and next_sid not in seen and next_sid in claude_idx:
            seen.add(next_sid)
            curr = next_sid
        else:
            break
    return curr

def find_active_session_info(
    pane: PaneContext,
    claude_idx: Dict[str, str],
    cc_sessions: Dict[str, Any],
    desc_pids: List[str]
) -> Tuple[Optional[str], Optional[str]]:
    """
    Resolve active session ID and its reported execution status across:
    - Parked background jobs in child processes (jobId / parkedJobId)
    - Directly recorded session processes
    - Pane claude_sid tags
    - Terminal buffer screen capture fallback
    - Session continuation chains (continuedInSessionId)
    """
    candidate = pane.claude_sid
    active_st = None

    # Check child processes for parked background jobs or active sessions
    for p in desc_pids:
        if p in cc_sessions:
            sess = cc_sessions[p]
            parked = sess.get("parkedJobId")
            if parked:
                for other_p, other_sess in cc_sessions.items():
                    if other_sess.get("jobId") == parked or (other_sess.get("sessionId") and other_sess["sessionId"].startswith(parked)):
                        candidate = other_sess.get("sessionId")
                        active_st = other_sess.get("status")
                        break
                if not candidate:
                    for target_sid in claude_idx:
                        if target_sid.startswith(parked):
                            candidate = target_sid
                            break
            elif not candidate or candidate not in claude_idx:
                candidate = sess.get("sessionId")
                active_st = sess.get("status")

    if not candidate or candidate not in claude_idx:
        for p in desc_pids:
            if p in cc_sessions:
                candidate = cc_sessions[p].get("sessionId")
                if candidate in claude_idx:
                    active_st = cc_sessions[p].get("status")
                    break

    # Screen fallback for active session short ID (e.g. 🔗 d10be121)
    if not candidate or candidate not in claude_idx:
        try:
            screen = subprocess.run(
                ["tmux", "capture-pane", "-pJ", "-S", "-15", "-t", pane.pane_id],
                capture_output=True,
                text=True,
                timeout=0.25
            ).stdout or ""
            m = re.search(r"🔗\s*([0-9a-f]{8})", screen)
            if m:
                short_id = m.group(1)
                for sid in claude_idx:
                    if sid.startswith(short_id):
                        candidate = sid
                        break
        except Exception:
            pass

    if candidate:
        resolved = resolve_session_chain(candidate, claude_idx)
        if resolved != candidate:
            for other_sess in cc_sessions.values():
                if other_sess.get("sessionId") == resolved:
                    active_st = other_sess.get("status")
                    break
        return resolved, active_st

    return None, None

class ClaudeAdapter(BaseAgentAdapter):
    name = "claude"
    display_name = "🟠 Claude"
    color = C_CLAUDE

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        if heads:
            return "claude" in heads
        return "claude" in pane.current_command or "claude" in full_desc or bool(pane.claude_sid)

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, Any]:
        claude_idx = shared_state.get("claude_idx", {})
        cc_status = shared_state.get("cc_status", {})
        cc_sessions = shared_state.get("cc_sessions", {})
        tree = shared_state.get("tree", {})
        my_pid = shared_state.get("my_pid", "")

        desc_pids = [str(pane.pid)]
        stack = [str(pane.pid)]
        while stack:
            curr = stack.pop()
            for cp, _ in tree.get(curr, []):
                if cp != my_pid and cp not in desc_pids:
                    desc_pids.append(cp)
                    stack.append(cp)

        active_sid, st = find_active_session_info(pane, claude_idx, cc_sessions, desc_pids)

        mtime = 0.0
        running = False
        rank = 2

        if active_sid and active_sid in claude_idx:
            mtime, running = claude_state(claude_idx[active_sid])
            if running:
                rank = 1

        if not st:
            for p in desc_pids:
                if p in cc_status:
                    st = cc_status[p]
                    break

        if st:
            if st in ("busy", "agents", "shell"):
                rank = 1
                if st == "agents":
                    running = "🤖 subagent"
                elif st == "shell":
                    running = "🐚 shell"
                else:
                    running = True
                if not mtime or (time.time() - mtime > 1800):
                    mtime = time.time()
            elif st == "waiting":
                rank = 0
                running = False
            elif st == "idle":
                if not running:
                    rank = 2
                    running = False

        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        return self.display_name, self.color, rank, mtime, disp_t, running

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        claude_paths = glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl"))
        claude_idx = {os.path.basename(p)[:-6]: p for p in claude_paths}

        cc_sessions = {}
        for f in glob.glob(os.path.expanduser("~/.claude*/sessions/*.json")):
            try:
                with open(f, "r", encoding="utf-8") as fh:
                    d = json.load(fh)
                cc_sessions[str(d.get("pid", ""))] = d
            except Exception:
                pass

        active_sid, _ = find_active_session_info(pane, claude_idx, cc_sessions, desc_pids)

        filepath = None
        if active_sid and active_sid in claude_idx:
            filepath = claude_idx[active_sid]
        elif pane.claude_sid:
            matches = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{pane.claude_sid}.jsonl"))
            if matches:
                filepath = matches[0]

        if filepath and os.path.exists(filepath):
            lines = read_tail_lines(filepath, max_bytes=300000, full=full_history)
            turns = extract_duck_turns(lines, full=full_history)
            if len(turns) < 4 and not full_history and os.path.exists(filepath) and os.path.getsize(filepath) > 300000:
                turns = extract_duck_turns(read_tail_lines(filepath, max_bytes=3000000), full=False)

            if turns:
                is_live = False
                try:
                    is_live = time.time() - os.path.getmtime(filepath) < 120
                except Exception:
                    pass
                content = format_turns(turns, live=is_live, full_history=full_history, preview_width=preview_width)
                return PreviewResult(
                    source_label=f"{self.display_name} · {disp_t}",
                    content=content
                )
        return None


# --- xAI Grok Adapter (adapters/grok.py) ---
"""xAI Grok adapter."""

class GrokAdapter(BaseAgentAdapter):
    name = "grok"
    display_name = "⚡ Grok"
    color = C_GROK

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return "grok" in heads or "grok" in pane.current_command or "grok" in full_desc

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        g_files = glob.glob(os.path.expanduser("~/.grok/sessions/**/chat_history.jsonl"), recursive=True)
        mtime = max((get_real_dialogue_time(f) for f in g_files), default=0.0)
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        return self.display_name, self.color, 2, mtime, disp_t, False

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        grok_act = os.path.expanduser("~/.grok/active_sessions.json")
        sid, cwd = None, None

        if os.path.exists(grok_act):
            try:
                with open(grok_act) as f:
                    active = json.load(f)
                for s in active:
                    if str(s.get("pid")) in desc_pids:
                        sid, cwd = s.get("session_id"), s.get("cwd")
                        break
                if not sid and active:
                    sid, cwd = active[-1].get("session_id"), active[-1].get("cwd")
            except Exception:
                pass

        if sid and cwd:
            cwd_enc = urllib.parse.quote(cwd, safe="")
            hf = os.path.expanduser(f"~/.grok/sessions/{cwd_enc}/{sid}/chat_history.jsonl")
            if os.path.exists(hf):
                lines = read_tail_lines(hf, full=full_history)
                turns = extract_duck_turns(lines, full=full_history)
                if turns:
                    content = format_turns(turns, live=True, full_history=full_history, preview_width=preview_width)
                    return PreviewResult(
                        source_label=f"{self.display_name} · {disp_t}",
                        content=content
                    )
        return None


# --- Google Antigravity / AGY Adapter (adapters/antigravity.py) ---
"""Google Antigravity (AGY) / Gemini adapter."""

class AntigravityAdapter(BaseAgentAdapter):
    name = "antigravity"
    display_name = "🤖 AGY"
    color = C_AGY

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return "agy" in heads or "agy" in pane.current_command or bool(pane.agy_tag)

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        agy_titles = shared_state.get("agy_titles", {})
        m = re.search(r"--conversation[=\s]+([0-9a-fA-F\-]{36})", full_desc)
        cid = pane.agy_tag or (m.group(1) if m else "")
        mtime = 0.0
        rank = 2
        status = "💤 idle"
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        running = False

        if cid:
            tpath = os.path.expanduser(f"~/.gemini/antigravity-cli/brain/{cid}/.system_generated/logs/transcript.jsonl")
            if os.path.exists(tpath):
                mtime = get_real_dialogue_time(tpath)
            if cid in agy_titles:
                t, idle = agy_titles[cid]
                disp_t = t
                if idle:
                    status = "⚡ run"
                    rank = 1
                    running = True
                else:
                    status = "💤 idle"

        if disp_t.startswith("Ga=") or not disp_t.strip():
            disp_t = "[AGY Session]"

        return self.display_name, self.color, rank, mtime, disp_t, running

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        m = re.search(r"--conversation[=\s]+([0-9a-fA-F\-]{36})", full_desc)
        cid = pane.agy_tag or (m.group(1) if m else "")

        if not cid:
            agy_map = os.path.expanduser("~/.tmux/resurrect/agy_session_map.txt")
            if os.path.exists(agy_map):
                try:
                    with open(agy_map) as f:
                        for line in f:
                            parts = line.strip().split("\t")
                            if parts and parts[0] == pane.pane_id and len(parts) >= 2:
                                cid = parts[1]
                                break
                except Exception:
                    pass

        if cid:
            tpath = os.path.expanduser(f"~/.gemini/antigravity-cli/brain/{cid}/.system_generated/logs/transcript.jsonl")
            if os.path.exists(tpath):
                lines = read_tail_lines(tpath, full=full_history)
                turns = extract_duck_turns(lines, full=full_history)
                if turns:
                    is_live = False
                    try:
                        is_live = time.time() - os.path.getmtime(tpath) < 120
                    except Exception:
                        pass
                    content = format_turns(turns, live=is_live, full_history=full_history, preview_width=preview_width)
                    return PreviewResult(
                        source_label=f"{self.display_name} · {disp_t}",
                        content=content
                    )
        return None


# --- OpenCode Adapter (adapters/opencode.py) ---
"""OpenCode adapter."""

class OpenCodeAdapter(BaseAgentAdapter):
    name = "opencode"
    display_name = "🟢 OpenCode"
    color = C_OPENCODE

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return "opencode" in heads or "opencode" in pane.current_command or bool(pane.oc_tag)

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        oc_sessions = shared_state.get("oc_sessions", [])
        oc_db = shared_state.get("oc_db")

        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).removeprefix("OC | ").strip()
        mtime = 0.0
        rank = 2
        running = False

        cands = [s for s in oc_sessions if s[0] == pane.oc_tag or (disp_t and disp_t in (s[1] or ""))]
        if cands:
            sid, _, t_upd = max(cands, key=lambda s: (s[1] == disp_t, s[0] == pane.oc_tag, s[2] or 0))
            mtime = (t_upd or 0) / 1000.0
            if oc_db:
                try:
                    last = oc_db.execute(
                        "SELECT json_extract(data, '$.role'), json_extract(data, '$.time.completed') "
                        "FROM message WHERE session_id = ? ORDER BY time_created DESC LIMIT 1",
                        (sid,)
                    ).fetchone()
                    running = bool(last) and (last[0] == "user" or last[1] is None)
                    if running:
                        rank = 1
                except Exception:
                    pass

        return self.display_name, self.color, rank, mtime, disp_t, running

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).removeprefix("OC | ").strip()
        clean_t = disp_t.split("|")[0].strip("[]* ")
        db_path = os.path.expanduser("~/.local/share/opencode/opencode.db")

        if os.path.exists(db_path):
            try:
                conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
                row = conn.execute(
                    'SELECT id, title, time_updated FROM session WHERE parent_id IS NULL AND '
                    '(id = ? OR title LIKE ? OR ? LIKE "%" || title || "%") '
                    'ORDER BY title = ? DESC, id = ? DESC, time_updated DESC LIMIT 1',
                    (pane.oc_tag, f"%{clean_t}%", clean_t, disp_t, pane.oc_tag)
                ).fetchone()

                if row:
                    sid, stitle, t_upd = row
                    # 300 part limit keeps query latency ~40ms even on huge sessions
                    limit = -1 if full_history else 300
                    recs = [
                        json.dumps({"role": r, "content": txt})
                        for r, txt in conn.execute(
                            "SELECT json_extract(m.data, '$.role'), json_extract(p.data, '$.text') "
                            "FROM part p JOIN message m ON m.id = p.message_id "
                            "WHERE p.id IN (SELECT id FROM part WHERE session_id = ? ORDER BY time_created DESC LIMIT ?) "
                            "AND json_extract(p.data, '$.type') = 'text' AND json_extract(p.data, '$.synthetic') IS NOT 1 "
                            "ORDER BY p.time_created",
                            (sid, limit)
                        ) if txt
                    ]
                    turns = extract_duck_turns(recs, full=full_history)
                    if turns:
                        is_live = False
                        if t_upd:
                            is_live = (time.time() - t_upd / 1000.0) < 120
                        content = format_turns(turns, live=is_live, full_history=full_history, preview_width=preview_width)
                        conn.close()
                        return PreviewResult(
                            source_label=f"{self.display_name} · {stitle}",
                            content=content
                        )
                conn.close()
            except Exception:
                pass
        return None


# --- Oh My Pi (OMP) Adapter (adapters/omp.py) ---
"""Oh My Pi (OMP) adapter."""

OMP_RE = re.compile(r"(^|[\s/])omp(\s|$)")

def load_omp_sessions() -> List[Tuple[str, str, str]]:
    """Scan ~/.omp/agent/sessions to index (session_id, filepath, title)."""
    idx = []
    for p in glob.glob(os.path.expanduser("~/.omp/agent/sessions/*/*.jsonl")):
        try:
            with open(p, "r", encoding="utf-8", errors="ignore") as f:
                first = f.readline()
                title = json.loads(first).get("title") or ""
                sid = p.rsplit("_", 1)[-1][:-6]
                idx.append((sid, p, title))
        except Exception:
            pass
    return idx

class OmpAdapter(BaseAgentAdapter):
    name = "omp"
    display_name = "🟣 OMP"
    color = C_OMP

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return bool(OMP_RE.search(heads)) or pane.current_command == "omp" or bool(OMP_RE.search(full_desc))

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        omp_idx = shared_state.setdefault("omp_idx", load_omp_sessions())
        cmd_of = shared_state.get("cmd_of", {})

        m = re.match(r"π (\S)\s*(.*)", pane.title)
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        state, t = m.groups() if m else (">", disp_t)

        status = "💤 idle"
        rank = 2
        running = False
        if state == "!":
            status = "🔔 input"
            rank = 0
        elif state != ">":
            status = "⚡ run"
            rank = 1
            running = True

        ids = {pane.omp_tag} | set(re.findall(r"(?:-r|--resume|resume)\s+([0-9a-f-]{36})", cmd_of.get(pane.pid, "") + " " + full_desc))
        cands = [s for s in omp_idx if s[2] == t or s[0] in ids]
        mtime = 0.0
        if cands:
            best_file = max(cands, key=lambda s: (s[2] == t, s[0] in ids, os.path.getmtime(s[1])))[1]
            mtime = get_real_dialogue_time(best_file)

        return self.display_name, self.color, rank, mtime, t, running

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        label = re.sub(r"^π \S\s*", "", pane.title)
        ids = {pane.omp_tag} | set(re.findall(r"(?:-r|--resume|resume)\s+([0-9a-f-]{36})", full_desc))
        best = None

        for p in glob.glob(os.path.expanduser("~/.omp/agent/sessions/*/*.jsonl")):
            try:
                with open(p, "r", encoding="utf-8", errors="ignore") as f:
                    st = json.loads(f.readline()).get("title") or ""
            except Exception:
                continue
            key = (st == label, p.rsplit("_", 1)[-1][:-6] in ids, os.path.getmtime(p))
            if (key[0] or key[1]) and (best is None or key > best[0]):
                best = (key, p, st)

        if best:
            turns = extract_duck_turns(read_tail_lines(best[1], full=full_history), full=full_history)
            if turns:
                is_live = False
                try:
                    is_live = time.time() - best[0][2] < 120
                except Exception:
                    pass
                content = format_turns(turns, live=is_live, full_history=full_history, preview_width=preview_width)
                return PreviewResult(
                    source_label=f"{self.display_name} · {best[2] or label}",
                    content=content
                )
        return None


# --- System Monitors Adapter (adapters/system_monitor.py) ---

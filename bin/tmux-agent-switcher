"""Terminal color palettes, ANSI escape codes, and display utilities."""

# Basic ANSI Controls
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_DIM = "\033[2m"
C_ITALIC = "\033[3m"
C_STRIKE = "\033[9m"

# Standard / High-Intensity Colors
C_RED_BOLD = "\033[1;31m"
C_GREEN_BOLD = "\033[1;32m"
C_CYAN_BOLD = "\033[1;36m"
C_WHITE = "\033[97m"
C_WHITE_BOLD = "\033[1;37m"

# 24-bit TrueColor Agent Palettes
C_AGY = "\033[1;38;2;78;136;245m"        # Google Gemini Spark Blue (#4E88F5)
C_CLAUDE = "\033[1;38;2;217;119;87m"     # Anthropic Terracotta Coral (#D97757)
C_CODEX = "\033[1;38;2;16;163;127m"      # OpenAI Emerald Teal (#10A37F)
C_CURSOR = "\033[1;38;2;226;232;240m"    # Cursor Titanium Silver (#E2E8F0)
C_GROK = "\033[1;38;2;240;240;245m"      # xAI Stark Monochrome (#F0F0F5)
C_CMD = "\033[1;38;2;6;182;212m"         # Command Code Cyan (#06B6D4)
C_OPENCODE = "\033[1;38;2;34;197;94m"    # OpenCode Vibrant Green (#22C55E)
C_OMP = "\033[1;38;2;167;139;250m"       # Oh My Pi Violet (#A78BFA)
C_MONITOR = "\033[38;2;148;163;184m"     # Telemetry Slate (#94A3B8)

# Dialogue Preview Palettes
C_ICE_BLUE = "\033[1;38;2;125;207;255m"
C_LAVENDER = "\033[1;38;2;187;154;247m"
C_MINT = "\033[38;2;158;206;106m"
C_PEACH = "\033[38;2;255;195;135m"
C_SLATE_BLUE = "\033[38;2;122;162;247m"
C_BORDER = "\033[38;2;86;95;137m"
C_DIVIDER = "\033[38;2;65;72;100m"
C_MUTED = "\033[38;2;140;145;170m"
C_LINK = "\033[4;38;2;125;207;255m"
C_TD = "\033[38;2;226;232;240m"

# Conversation Turn Bubble Styling
C_USER_BG = "\033[1;48;2;76;29;149;38;2;233;213;255m"
C_USER_TXT = "\033[1;38;2;243;232;255m"
C_ACTIVE_BG = "\033[1;48;2;120;53;15;38;2;254;240;138m"
C_ACTIVE_TXT = "\033[1;38;2;254;243;199m"
C_BAR_ACTIVE = "\033[38;2;245;158;11m"
C_BAR_USER = "\033[38;2;168;85;247m"

SHELLS = ("zsh", "-zsh", "bash", "sh", "fish")

def char_width(c: str) -> int:
    """Return monospace display width for a single character (handles CJK/emojis)."""
    cp = ord(c)
    if (0x1100 <= cp <= 0x115F or 0x2E80 <= cp <= 0xA4CF or
        0xAC00 <= cp <= 0xD7A3 or 0xF900 <= cp <= 0xFAFF or
        0xFE10 <= cp <= 0xFE19 or 0xFE30 <= cp <= 0xFE6F or
        0xFF00 <= cp <= 0xFF60 or 0xFFE0 <= cp <= 0xFFE6 or
        0x1F300 <= cp <= 0x1F9FF or 0x20000 <= cp <= 0x2FA1F):
        return 2
    return 1

def str_display_width(s: str) -> int:
    """Calculate terminal visual width of a string, ignoring ANSI and OSC sequences."""
    s_clean = re.sub(r'\033\]8;;[^\033]*\033\\', '', s)
    s_clean = re.sub(r'\033\[[0-9;]*[a-zA-Z]', '', s_clean)
    return sum(char_width(c) for c in s_clean)

def pad_str(s: str, target_width: int) -> str:
    """Pad string with trailing spaces to match target display width."""
    curr_w = str_display_width(s)
    pad = max(0, target_width - curr_w)
    return s + " " * pad


# ==============================================================================
# SECTION: Core Data Types
# Source: core/types.py
# ==============================================================================
"""Core data types and structures for Tmux Agent Switcher."""

@dataclass
class PaneContext:
    """Represents full contextual metadata of a single Tmux pane."""
    pane_id: str                      # e.g. "%43" or "session:1.2"
    pid: str                          # Root PID of the pane (shell or direct process)
    current_command: str              # e.g. "zsh", "claude", "python3"
    title: str                        # Pane title (from terminal escape or tmux)
    bell_flag: str                    # "1" if bell was triggered
    pane_active: str                  # "1" if pane is active in its window
    window_active: str                # "1" if window is active in its session
    session_attached: str             # "1" if session has a client attached
    cwd: str                          # Current working directory of pane
    tty: str                          # /dev/ttys00x
    width: str = ""
    height: str = ""
    # Extended hook tags
    claude_sid: str = ""              # #{@claude-session-id}
    agy_tag: str = ""                 # #{@agy-session-id}
    cmd_code_sid: str = ""            # #{@command-code-session-id}
    oc_tag: str = ""                  # #{@opencode-session-id}
    omp_tag: str = ""                 # #{@omp-session-id}
    pane_needs_input: str = ""        # #{@pane-needs-input}

@dataclass
class AgentStatusInfo:
    """Result of agent detection and status extraction for list view."""
    harness: str                      # e.g. "🟠 Claude", "🤖 AGY", "💻 Shell"
    harness_color: str                # ANSI color escape sequence
    status: str                       # e.g. "🔔 input", "⚡ run", "💤 idle"
    status_color: str                 # ANSI color escape sequence
    rank: int                         # Sort rank: 0 (input), 1 (run), 2 (idle), 3 (monitor), 4 (shell)
    mtime: float                      # Epoch timestamp of last user/agent dialogue
    age_str: str                      # e.g. "5s", "12m", "2h", "LIVE", " - "
    display_title: str                # Title for the list column (up to 60 chars)
    is_current: bool                  # True if currently focused pane
    formatted_line: str = ""          # Complete ANSI formatted string for fzf

@dataclass
class TurnMessage:
    """Represents a conversational turn."""
    user: str = ""
    assistant: str = ""

@dataclass
class PreviewResult:
    """Formatted preview content for fzf right pane."""
    source_label: str                 # Header label, e.g. "🟠 Claude · feature-auth"
    content: str                      # Rendered ANSI content (bubbles, markdown, etc.)


# ==============================================================================
# SECTION: Process Tree & Tmux Introspection
# Source: core/tmux.py
# ==============================================================================
"""Tmux interface and process tree discovery utilities."""

OMP_PATTERN = r"(^|[\s/])omp(\s|$)"
AGENTS_REGEX = re.compile(r"cursor-agent|codex|command-code|claude|grok|agy|opencode|" + OMP_PATTERN)

class ProcessTree:
    """Represents a snapshot of the operating system process tree."""

    def __init__(self, my_pid: Optional[str] = None):
        self.my_pid = my_pid or str(os.getpid())
        self.tree: Dict[str, List[Tuple[str, str]]] = collections.defaultdict(list)
        self.cmd_of: Dict[str, str] = {}

    @classmethod
    def from_system(cls, tty: Optional[str] = None) -> "ProcessTree":
        """Capture process tree for the entire system or scoped to a specific TTY."""
        instance = cls()
        cmd = ["ps", "-t", tty, "-o", "pid,ppid,command"] if tty else ["ps", "-eo", "pid,ppid,command"]
        try:
            res = subprocess.run(cmd, capture_output=True, check=False)
            lines = res.stdout.decode("utf-8", errors="ignore").strip().splitlines()
            for line in lines[1:]:
                parts = line.strip().split(None, 2)
                if len(parts) == 3:
                    instance.tree[parts[1]].append((parts[0], parts[2]))
                    instance.cmd_of[parts[0]] = parts[2]
        except Exception:
            pass
        return instance

    def get_descendants(self, pid: str) -> str:
        """Collect command lines of all descendant processes under pid."""
        cmds: List[str] = []
        stack = [str(pid)]
        while stack:
            curr = stack.pop()
            for child_pid, child_cmd in self.tree.get(curr, []):
                if child_pid == self.my_pid:
                    continue
                cmds.append(child_cmd)
                stack.append(child_pid)
        return " ".join(cmds)

    def get_descendant_pids(self, pid: str) -> List[str]:
        """Collect all descendant PIDs under pid."""
        pids: List[str] = []
        stack = [str(pid)]
        while stack:
            curr = stack.pop()
            for child_pid, _ in self.tree.get(curr, []):
                if child_pid == self.my_pid:
                    continue
                pids.append(child_pid)
                stack.append(child_pid)
        return pids

    def get_agent_heads(self, pid: str) -> str:
        """
        Find the shallowest process whose program (first two words) names an agent.
        Deeper processes are tools whose args may accidentally mention another agent.
        """
        level = [str(pid)]
        while level:
            heads = " ".join(" ".join(self.cmd_of.get(p, "").split()[:2]) for p in level)
            if AGENTS_REGEX.search(heads):
                return heads
            level = [c for p in level for c, _ in self.tree.get(p, []) if c != self.my_pid]
        return ""

def list_all_panes() -> List[PaneContext]:
    """
    Fetch all panes across all sessions in a single tmux list-panes call.
    Zero per-pane overhead.
    """
    format_spec = (
        "#{session_name}:#{window_index}.#{pane_index}\t"
        "#{pane_pid}\t"
        "#{pane_current_command}\t"
        "#{pane_title}\t"
        "#{window_bell_flag}\t"
        "#{pane_active}\t"
        "#{window_active}\t"
        "#{@agy-session-id}\t"
        "#{@pane-needs-input}\t"
        "#{@command-code-session-id}\t"
        "#{@claude-session-id}\t"
        "#{pane_current_path}\t"
        "#{session_attached}\t"
        "#{@opencode-session-id}\t"
        "#{@omp-session-id}\t"
        "#{pane_tty}\t"
        "#{pane_width}\t"
        "#{pane_height}"
    )
    try:
        raw = subprocess.check_output([
            "tmux", "list-panes", "-a", "-F", format_spec
        ]).decode("utf-8", errors="ignore").strip().splitlines()
    except Exception:
        return []

    panes = []
    for line in raw:
        if not line.strip():
            continue
        parts = line.split("\t")
        if len(parts) < 13:
            continue
        panes.append(PaneContext(
            pane_id=parts[0],
            pid=parts[1],
            current_command=parts[2],
            title=parts[3],
            bell_flag=parts[4],
            pane_active=parts[5],
            window_active=parts[6],
            agy_tag=parts[7].strip() if len(parts) > 7 else "",
            pane_needs_input=parts[8].strip() if len(parts) > 8 else "",
            cmd_code_sid=parts[9].strip() if len(parts) > 9 else "",
            claude_sid=parts[10].strip() if len(parts) > 10 else "",
            cwd=parts[11] if len(parts) > 11 else "",
            session_attached=parts[12] if len(parts) > 12 else "1",
            oc_tag=parts[13].strip() if len(parts) > 13 else "",
            omp_tag=parts[14].strip() if len(parts) > 14 else "",
            tty=parts[15].strip() if len(parts) > 15 else "",
            width=parts[16].strip() if len(parts) > 16 else "",
            height=parts[17].strip() if len(parts) > 17 else "",
        ))
    return panes

def get_pane_context(pane_id: str) -> Optional[PaneContext]:
    """Retrieve metadata for a specific target pane via tmux display-message."""
    format_spec = (
        "#{pane_pid}\t"
        "#{pane_current_command}\t"
        "#{pane_title}\t"
        "#{pane_width}x#{pane_height}\t"
        "#{pane_tty}\t"
        "#{@claude-session-id}\t"
        "#{@command-code-session-id}\t"
        "#{@opencode-session-id}\t"
        "#{@omp-session-id}\t"
        "#{@agy-session-id}\t"
        "#{@pane-needs-input}\t"
        "#{pane_current_path}"
    )
    try:
        raw_info = subprocess.check_output([
            "tmux", "display-message", "-p", "-t", pane_id, format_spec
        ]).decode("utf-8", errors="ignore").rstrip("\n").split("\t") + [""] * 12

        geom = raw_info[3]
        w, h = geom.split("x") if "x" in geom else ("", "")
        return PaneContext(
            pane_id=pane_id,
            pid=raw_info[0],
            current_command=raw_info[1] or "shell",
            title=raw_info[2] or pane_id,
            width=w,
            height=h,
            tty=raw_info[4],
            claude_sid=raw_info[5],
            cmd_code_sid=raw_info[6],
            oc_tag=raw_info[7],
            omp_tag=raw_info[8],
            agy_tag=raw_info[9],
            pane_needs_input=raw_info[10],
            cwd=raw_info[11],
            bell_flag="0",
            pane_active="1",
            window_active="1",
            session_attached="1",
        )
    except Exception:
        return PaneContext(
            pane_id=pane_id,
            pid="",
            current_command="shell",
            title=pane_id,
            bell_flag="0",
            pane_active="1",
            window_active="1",
            session_attached="1",
            cwd="",
            tty="",
        )


# ==============================================================================
# SECTION: Unicode Table Renderer
# Source: formatters/table.py
# ==============================================================================
"""Unicode box-drawing table renderer for markdown tables."""

def render_table(rows: List[str], style_inline_fn) -> List[str]:
    """
    Render GFM-style markdown table rows into beautiful Unicode box-drawing tables.
    Accurately accounts for CJK double-width characters and inline styles.
    """
    if not rows:
        return []

    table_data = []
    for r in rows:
        cells = [c.strip() for c in r.strip().strip('|').split('|')]
        table_data.append(cells)

    if not table_data:
        return []

    header = table_data[0]
    data_rows = []
    for r in table_data[1:]:
        if all(re.match(r"^:?-+:?$", c) for c in r if c):
            continue
        data_rows.append(r)

    num_cols = max(len(r) for r in table_data)
    col_widths = [0] * num_cols

    for r in [header] + data_rows:
        for i, c in enumerate(r):
            if i < num_cols:
                col_widths[i] = max(col_widths[i], str_display_width(style_inline_fn(c)))

    col_widths = [max(w, 4) for w in col_widths]

    top = C_BORDER + "┌─" + "─┬─".join("─" * w for w in col_widths) + "─┐" + C_RESET
    mid = C_BORDER + "├─" + "─┼─".join("─" * w for w in col_widths) + "─┤" + C_RESET
    bot = C_BORDER + "└─" + "─┴─".join("─" * w for w in col_widths) + "─┘" + C_RESET

    res = [top]
    h_cells = []
    for i in range(num_cols):
        raw = header[i] if i < len(header) else ""
        styled = style_inline_fn(raw, C_ICE_BLUE)
        h_cells.append(pad_str(f"{C_ICE_BLUE}{styled}{C_RESET}", col_widths[i]))
    res.append(f"{C_BORDER}│{C_RESET} " + f" {C_BORDER}│{C_RESET} ".join(h_cells) + f" {C_BORDER}│{C_RESET}")
    res.append(mid)

    for r in data_rows:
        d_cells = []
        for i in range(num_cols):
            raw = r[i] if i < len(r) else ""
            styled = style_inline_fn(raw, C_TD)
            d_cells.append(pad_str(f"{C_TD}{styled}{C_RESET}", col_widths[i]))
        res.append(f"{C_BORDER}│{C_RESET} " + f" {C_BORDER}│{C_RESET} ".join(d_cells) + f" {C_BORDER}│{C_RESET}")

    res.append(bot)
    return res


# ==============================================================================
# SECTION: Markdown Syntax Styler
# Source: formatters/markdown.py
# ==============================================================================
"""Markdown parser and ANSI syntax highlighter."""

def wrap_text(text: str, width: int = 0, indent: int = 0) -> List[str]:
    """
    Pre-wrap text to preview width so continuation lines retain proper indent/rail.
    Protects spaces inside `code` and **bold** spans before wrapping.
    """
    effective_w = width or int(os.environ.get("FZF_PREVIEW_COLUMNS") or 0)
    if not effective_w or effective_w - indent < 20:
        return [text]

    protected = re.sub(
        r"`[^`]*`|\*\*[^*]*\*\*",
        lambda m: m.group(0).replace(" ", "\x00"),
        text
    )
    wrapped = textwrap.wrap(
        protected,
        effective_w - indent - 1,
        break_long_words=False,
        break_on_hyphens=False
    )
    return [l.replace("\x00", " ") for l in wrapped] or [text]

def style_inline(text: str, base_col: str = "") -> str:
    """Apply inline markdown ANSI formatting: code, links, bold, italic, strikethrough."""
    s = text
    code_tokens = []

    def save_code(m):
        code_tokens.append(f"{C_PEACH}{m.group(1)}{C_RESET}{base_col}")
        return f"\x00CODE_{len(code_tokens)-1}\x00"

    s = re.sub(r"`([^`]+)`", save_code, s)

    def render_link(m):
        txt, url = m.group(1), m.group(2)
        return f"\033]8;;{url}\033\\{C_LINK}{txt}{C_RESET}{base_col}\033]8;;\033\\"

    s = re.sub(r"\[([^\]]+)\]\((https?://[^\)]+|file://[^\)]+|/[^\)]+)\)", render_link, s)

    s = re.sub(r"\*\*\*([^\*]+?)\*\*\*", rf"{C_WHITE_BOLD}{C_ITALIC}\1{C_RESET}{base_col}", s)
    s = re.sub(r"___([^_]+?)___", rf"{C_WHITE_BOLD}{C_ITALIC}\1{C_RESET}{base_col}", s)
    s = re.sub(r"\*\*([^\*]+?)\*\*", rf"{C_WHITE_BOLD}\1{C_RESET}{base_col}", s)
    s = re.sub(r"(?<!\w)__([^_]+?)__(?!\w)", rf"{C_WHITE_BOLD}\1{C_RESET}{base_col}", s)
    s = re.sub(r"(?<!\*)\*([^\*\s][^\*]*?[^\*\s]|[^\*\s])\*(?!\*)", rf"{C_ITALIC}\1{C_RESET}{base_col}", s)
    s = re.sub(r"(?<!\w)_([^_\s][^_]*?[^_\s]|[^_\s])_(?!\w)", rf"{C_ITALIC}\1{C_RESET}{base_col}", s)
    s = re.sub(r"~~([^~]+?)~~", rf"{C_STRIKE}{C_MUTED}\1{C_RESET}{base_col}", s)

    for i, tok in enumerate(code_tokens):
        s = s.replace(f"\x00CODE_{i}\x00", tok)
    return s

def render_md(text: str, preview_width: int = 0) -> str:
    """Render block Markdown to richly styled ANSI terminal output."""
    out = []
    in_code = False
    table_buf: List[str] = []

    def flush_table():
        nonlocal table_buf
        if table_buf:
            out.extend(render_table(table_buf, style_inline))
            table_buf = []

    for line in text.split("\n"):
        if line.strip().startswith("```"):
            flush_table()
            in_code = not in_code
            lang = line.strip().lstrip("`")
            out.append(
                f"{C_BORDER}─── {lang or 'code'} ──────────────────────────────────────────{C_RESET}"
                if in_code else f"{C_BORDER}{'─' * 50}{C_RESET}"
            )
            continue

        if in_code:
            out.append(f"  {C_MINT}{line}{C_RESET}")
            continue

        if line.strip().startswith("|") and line.strip().endswith("|"):
            table_buf.append(line.strip())
            continue
        else:
            flush_table()

        m_hdr = re.match(r"^(#{1,6})\s*(.+)$", line)
        if m_hdr:
            lvl = len(m_hdr.group(1))
            body = style_inline(m_hdr.group(2).strip().rstrip("#").strip())
            if lvl == 1:
                out.append(f"\n{C_ICE_BLUE}{C_BOLD}✦ {body}{C_RESET}")
            elif lvl == 2:
                out.append(f"\n{C_ICE_BLUE}{C_BOLD}■ {body}{C_RESET}")
            elif lvl == 3:
                out.append(f"\n{C_SLATE_BLUE}{C_BOLD}▲ {body}{C_RESET}")
            else:
                out.append(f"\n{C_MINT}{C_BOLD}▸ {body}{C_RESET}")
            continue

        if line.strip().startswith(">"):
            for q in wrap_text(line.strip().lstrip("> "), preview_width, 4):
                out.append(f"  {C_BORDER}│{C_RESET} {C_MUTED}{C_ITALIC}{style_inline(q, C_MUTED)}{C_RESET}")
            continue

        m_task = re.match(r"^(\s*)[\*\-\+]\s+\[([ xX])\]\s+(.*)$", line)
        if m_task:
            indent = m_task.group(1)
            checked = m_task.group(2).lower() == 'x'
            badge = f"{C_MINT}☑{C_RESET}" if checked else f"{C_MUTED}☐{C_RESET}"
            for i, b in enumerate(wrap_text(m_task.group(3), preview_width, len(indent) + 2)):
                out.append(f"{indent}{badge if i == 0 else ' '} {style_inline(b)}")
            continue

        if re.match(r"^\s*[\*\-\•]\s+", line):
            indent = len(line) - len(line.lstrip())
            body = re.sub(r"^\s*[\*\-\•]\s+", "", line)
            for i, b in enumerate(wrap_text(body, preview_width, indent + 2)):
                out.append(" " * indent + (f"{C_SLATE_BLUE}•{C_RESET} " if i == 0 else "  ") + style_inline(b))
            continue

        m_num = re.match(r"^(\s*\d+\.\s+)(.+)$", line)
        if m_num:
            p = m_num.group(1)
            for i, b in enumerate(wrap_text(m_num.group(2), preview_width, len(p))):
                out.append((f"{C_ICE_BLUE}{p}{C_RESET}" if i == 0 else " " * len(p)) + style_inline(b))
            continue

        if re.match(r"^(\-{3,}|\_{3,}|\*{3,})$", line.strip()):
            out.append(f"{C_DIVIDER}─────────────────────────────────────────────────────────────────{C_RESET}")
            continue

        lead = len(line) - len(line.lstrip())
        for b in wrap_text(line.strip(), preview_width, lead):
            out.append(" " * lead + style_inline(b))

    flush_table()
    return "\n".join(out)


# ==============================================================================
# SECTION: Terminal Screen De-Noiser
# Source: formatters/denoiser.py
# ==============================================================================
"""Terminal output semantic de-noiser."""

DENOISE_PATTERNS = [
    r"^.*(?:Token Monitor|AI Ledger|Shift\+Tab|Ctrl\+\.|\b\d+x\d+\b|\d+K\s*/\s*\d+K).*$",
    r"^.*(?:always-approve|Worked for \d+|［hooks：|\bhooks:\b).*$",
    r"^[│┌┐└┘├┤┬┴┼━┃┏┓┗┛┣┫┳┻╋═║╔╗╚╝╠╣╦╩╬╭╮╯╰─\s]+$",
    r"^[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+.*$",
    r"^\s*[L•]\s*$",
    r"^\s*\d+:\d+\s*(?:AM|PM)?\s*$",
    r"^.*(?:<truncated \d+ bytes>|truncated \d+ bytes).*$",
    r"^.*(?:Transfer-Encoding:\s*chunked|\bchunked\s+\d+\s*bytes\b).*$",
]
COMBINED_DENOISE_RE = re.compile("|".join(f"(?:{p})" for p in DENOISE_PATTERNS), re.IGNORECASE)

def denoise_terminal_text(text: str) -> str:
    """
    Filter raw terminal screen captures into clean, readable text.
    Strips noise like spinners, status bars, timestamps, shell prompt indicators,
    and orphan border characters.
    """
    lines = []
    for l in text.split("\n"):
        line = l.rstrip()
        if not line.strip():
            if lines and lines[-1]:
                lines.append("")
            continue
        if COMBINED_DENOISE_RE.match(line):
            continue
        clean_l = re.sub(r"^[〉❯>›]\s*", "", line)
        lines.append(clean_l)

    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and not lines[-1].strip():
        lines.pop()

    return "\n".join(lines)


# ==============================================================================
# SECTION: Dialogue Turn Bubbles
# Source: formatters/bubbles.py
# ==============================================================================
"""Conversational turn bubble formatter for preview panel."""

def format_turns(
    turns: List[Dict[str, str]],
    live: bool = True,
    full_history: Optional[bool] = None,
    preview_width: int = 0
) -> str:
    """
    Format conversational turns into styled bubbles.
    - User turns: styled pills with rounded left-rail box.
    - Assistant turns: markdown rendered with tables and syntax highlighting.
    - Live indicator: indicates actively running turn if unanswered.
    """
    if full_history is None:
        full_history = "full history" in os.environ.get("FZF_PREVIEW_LABEL", "")

    effective_w = preview_width or int(os.environ.get("FZF_PREVIEW_COLUMNS") or 0)
    parts = []
    total = len(turns)

    for i, t in enumerate(turns):
        u, a = t.get("user", "").strip(), t.get("assistant", "").strip()
        is_latest = (i == total - 1)
        turn_num = i + 1
        turn_badge = f"{C_DIVIDER}─── ✦ Turn {turn_num} of {total} ──────────────────────────────────────{C_RESET}"
        turn_parts = [turn_badge]

        if u:
            is_active = is_latest and not a and live
            pill = f"{C_ACTIVE_BG} ⚡ YOU (Active) {C_RESET}" if is_active else f"{C_USER_BG} 👤 YOU {C_RESET}"
            txt_col = C_ACTIVE_TXT if is_active else C_USER_TXT
            bar_col = C_BAR_ACTIVE if is_active else C_BAR_USER

            u_lines = [w for ul in u.split("\n") for w in wrap_text(ul, effective_w, 4)]
            if len(u_lines) > 12 and not full_history:
                u_lines = u_lines[:12] + [f"{C_MUTED}… +{len(u_lines) - 12} more lines{C_RESET}"]

            user_box = [f"{pill}"]
            for ul in u_lines:
                user_box.append(f"  {bar_col}│{C_RESET} {txt_col}{ul}{C_RESET}")
            user_box.append(f"  {bar_col}└──{C_RESET}")
            turn_parts.append("\n".join(user_box))

        if a:
            turn_parts.append(render_md(a, effective_w))
        elif is_latest and u and live:
            turn_parts.append(f"\n  \033[1;33m⚡ Agent is actively running...\033[0m\n")

        parts.append("\n\n".join(turn_parts))

    if full_history:
        parts.append(f"{C_DIVIDER}── 📜 full history · {total} turns · ctrl-o: recent only ──{C_RESET}")
    elif total >= 4:
        parts.append(f"{C_DIVIDER}── last {total} turns · ctrl-o: full history ──{C_RESET}")

    return "\n\n".join(parts)


# ==============================================================================
# SECTION: Agent Adapter Interface & Duck Parsing
# Source: adapters/base.py
# ==============================================================================
"""Base interface and parsing utilities for AI Agent adapters."""

def read_tail_lines(filepath: str, max_bytes: int = 800000, full: bool = False) -> List[str]:
    """
    Read tail lines from file without loading entire multi-gigabyte logs into RAM.
    If full is True, reads the entire file.
    """
    if not filepath or not os.path.exists(filepath):
        return []
    try:
        size = os.path.getsize(filepath)
        start = 0 if full else max(0, size - max_bytes)
        with open(filepath, "rb") as f:
            f.seek(start)
            raw = f.read().decode("utf-8", errors="ignore").strip().split("\n")
            return raw[1:] if start and len(raw) > 1 else raw
    except Exception:
        return []

def get_real_dialogue_time(filepath: str, max_bytes: int = 250000) -> float:
    """
    Extract the real timestamp of the most recent human prompt or agent reply.
    Avoids using raw mtime when loggers/watchdogs touch the file passively.
    """
    if not filepath or not os.path.exists(filepath):
        return 0.0
    try:
        size = os.path.getsize(filepath)
        with open(filepath, "rb") as f:
            f.seek(max(0, size - max_bytes))
            lines = f.read().decode("utf-8", errors="ignore").splitlines()
        for l in reversed(lines):
            try:
                d = json.loads(l)
                t = d.get("type", "")
                r = d.get("message", {}).get("role", "") if isinstance(d.get("message"), dict) else d.get("role", "")
                if t in ("user", "assistant", "USER_INPUT", "PLANNER_RESPONSE") or r in ("user", "assistant", "human", "model"):
                    ts = d.get("timestamp") or d.get("created_at")
                    if ts:
                        if isinstance(ts, (int, float)):
                            return ts / 1000.0 if ts > 1e11 else float(ts)
                        return datetime.datetime.fromisoformat(str(ts).replace("Z", "+00:00")).timestamp()
            except Exception:
                pass
        return os.path.getmtime(filepath)
    except Exception:
        return 0.0

def extract_duck_turns(lines: List[str], full: bool = False) -> List[Dict[str, str]]:
    """
    Duck-typing turn extractor supporting multiple schemas across Claude, AGY,
    Codex, Cursor, Grok, Command Code, and OMP.
    """
    turns: List[Dict[str, str]] = []
    curr = {"user": "", "assistant": ""}
    user_tags = {"user", "human", "usermessage", "user_input", "user_prompt"}
    asst_tags = {"assistant", "agent", "model", "agentmessage", "planner_response"}

    def extract_text(val: Any) -> str:
        if not val:
            return ""
        if isinstance(val, str):
            return val
        if isinstance(val, list):
            res = []
            for item in val:
                if isinstance(item, str):
                    res.append(item)
                elif isinstance(item, dict):
                    if item.get("type") == "text" and item.get("text"):
                        res.append(item["text"])
                    elif "text" in item and isinstance(item["text"], str):
                        res.append(item["text"])
                    elif "content" in item:
                        res.append(extract_text(item["content"]))
            return "\n".join(res)
        if isinstance(val, dict):
            return val.get("text") or extract_text(val.get("content")) or ""
        return str(val)

    for l in reversed(lines):
        if not l.strip():
            continue
        try:
            d = json.loads(l)
        except Exception:
            continue
        if not isinstance(d, dict) or d.get("isMeta") or d.get("isCompactSummary"):
            continue

        msg = d.get("message") if isinstance(d.get("message"), dict) else d
        role = (msg.get("role") or d.get("type") or msg.get("type") or "").lower()
        raw_c = msg.get("content") or d.get("content") or msg.get("text") or d.get("text")

        # Claude tool results are stored with role="user" but contain tool_result items
        if isinstance(raw_c, list) and any(isinstance(x, dict) and x.get("type") == "tool_result" for x in raw_c):
            continue

        text = extract_text(raw_c)
        if text.lstrip().startswith(("<command-", "<local-command-")):
            continue

        text = re.sub(r"<(ADDITIONAL_METADATA|system-reminder)>.*?</\1>", "", text, flags=re.DOTALL)
        text = re.sub(r"\s*📒 Possibly-relevant notes.*", "", text, flags=re.DOTALL)
        text = re.sub(r"\x1b\[[0-9;]*[A-Za-z]|</?[a-zA-Z0-9_-]+>", "", text).strip()

        if role in asst_tags and not curr["assistant"]:
            if text:
                curr["assistant"] = text
        elif role in user_tags:
            if text:
                curr["user"] = text
                if curr["assistant"] or curr["user"]:
                    turns.append(curr)
                    curr = {"user": "", "assistant": ""}
                    if len(turns) >= 4 and not full:
                        break

    if curr["assistant"]:
        turns.append(curr)

    turns.reverse()
    return turns

class BaseAgentAdapter:
    """Base class for agent detection, status tracking, and preview rendering."""

    name: str = "base"
    display_name: str = "Base"
    color: str = C_DIM

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        """Return True if this adapter handles the given pane."""
        raise NotImplementedError

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        """
        Extract list view status for this pane.
        Returns:
            (harness_label, harness_color, rank, mtime, title, is_running)
        """
        raise NotImplementedError

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        """
        Extract preview content for this pane.
        Returns PreviewResult or None if unhandled.
        """
        raise NotImplementedError



"""Command Code adapter."""

class CommandCodeAdapter(BaseAgentAdapter):
    name = "command-code"
    display_name = "⚡ Cmd"
    color = C_CMD

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return "command-code" in heads or bool(pane.cmd_code_sid) or "command-code" in full_desc

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        mtime = 0.0
        if pane.cmd_code_sid:
            c_files = glob.glob(os.path.expanduser(f"~/.commandcode/projects/**/{pane.cmd_code_sid}*.jsonl"), recursive=True)
            if c_files:
                mtime = get_real_dialogue_time(c_files[0])
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        return self.display_name, self.color, 2, mtime, disp_t, False

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        if pane.cmd_code_sid and not ("codex" in full_desc or "@openai/codex" in full_desc):
            c_files = glob.glob(os.path.expanduser(f"~/.commandcode/projects/**/{pane.cmd_code_sid}*.jsonl"), recursive=True)
            if c_files:
                lines = read_tail_lines(c_files[0], full=full_history)
                turns = extract_duck_turns(lines, full=full_history)
                if turns:
                    content = format_turns(turns, live=True, full_history=full_history, preview_width=preview_width)
                    return PreviewResult(
                        source_label=f"{self.display_name} · {disp_t}",
                        content=content
                    )
        return None


# ==============================================================================
# SECTION: Anthropic Claude Code Adapter
# Source: adapters/claude.py
# ==============================================================================
"""Anthropic Claude Code adapter."""

def claude_state(fpath: str, max_bytes: int = 250000) -> Tuple[float, bool]:
    """
    Determine last dialogue timestamp and whether the turn is still open.
    A finished turn ends in stop_hook_summary or turn_duration.
    """
    try:
        with open(fpath, "rb") as f:
            f.seek(max(0, os.path.getsize(fpath) - max_bytes))
            lines = f.read().decode("utf-8", errors="ignore").splitlines()
    except Exception:
        return 0.0, False

    ended = False
    for l in reversed(lines):
        try:
            d = json.loads(l)
        except Exception:
            continue
        if not isinstance(d, dict):
            continue
        t = d.get("type")
        if t == "system" and d.get("subtype") in ("stop_hook_summary", "turn_duration"):
            ended = True
        if t not in ("user", "assistant") or not d.get("timestamp"):
            continue
        ts = datetime.datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00")).timestamp()
        m = d.get("message") or {}
        c = json.dumps(m.get("content"))
        if ended or d.get("isMeta") or "[Request interrupted" in c or c.startswith(("\"<command-", "\"<local-command-")):
            return ts, False
        return ts, t == "user" or m.get("stop_reason") in (None, "tool_use")

    try:
        return os.path.getmtime(fpath), False
    except Exception:
        return 0.0, False

class ClaudeAdapter(BaseAgentAdapter):
    name = "claude"
    display_name = "🟠 Claude"
    color = C_CLAUDE

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        if heads:
            return "claude" in heads
        return "claude" in pane.current_command or "claude" in full_desc

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        claude_idx = shared_state.get("claude_idx", {})
        cc_status = shared_state.get("cc_status", {})
        tree = shared_state.get("tree", {})
        my_pid = shared_state.get("my_pid", "")

        mtime = 0.0
        running = False
        rank = 2
        status = "💤 idle"

        if pane.claude_sid in claude_idx:
            mtime, running = claude_state(claude_idx[pane.claude_sid])

        # Find shallowest process registered in cc_status
        st = None
        level = [str(pane.pid)]
        while level:
            for p in level:
                if p in cc_status:
                    st = cc_status[p]
                    break
            if st:
                break
            level = [c for p in level for c, _ in tree.get(p, []) if c != my_pid]

        if st:
            if st == "busy" and pane.claude_sid in claude_idx and not running:
                st = "agents"
            running = False
            status_map = {
                "busy": ("⚡ run", 1),
                "agents": ("🤖 subagent", 1),
                "shell": ("🐚 shell", 1),
                "waiting": ("🔔 input", 0)
            }
            if st in status_map:
                status, rank = status_map[st]

        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        return self.display_name, self.color, rank, mtime, disp_t, running

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        matches = []
        if pane.claude_sid:
            matches = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{pane.claude_sid}.jsonl"))

        if not matches:
            # Fallback: find by newest jsonl in ~/.claude/projects
            all_files = glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl"))
            if all_files:
                matches = [max(all_files, key=os.path.getmtime)]

        if matches:
            filepath = matches[0]
            lines = read_tail_lines(filepath, max_bytes=300000, full=full_history)
            turns = extract_duck_turns(lines, full=full_history)
            if len(turns) < 4 and not full_history and os.path.exists(filepath) and os.path.getsize(filepath) > 300000:
                turns = extract_duck_turns(read_tail_lines(filepath, max_bytes=3000000), full=False)

            if turns:
                is_live = False
                try:
                    is_live = time.time() - os.path.getmtime(filepath) < 120
                except Exception:
                    pass
                content = format_turns(turns, live=is_live, full_history=full_history, preview_width=preview_width)
                return PreviewResult(
                    source_label=f"{self.display_name} · {disp_t}",
                    content=content
                )
        return None


# ==============================================================================
# SECTION: xAI Grok Adapter
# Source: adapters/grok.py
# ==============================================================================
"""xAI Grok adapter."""

class GrokAdapter(BaseAgentAdapter):
    name = "grok"
    display_name = "⚡ Grok"
    color = C_GROK

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return "grok" in heads or "grok" in pane.current_command or "grok" in full_desc

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        g_files = glob.glob(os.path.expanduser("~/.grok/sessions/**/chat_history.jsonl"), recursive=True)
        mtime = max((get_real_dialogue_time(f) for f in g_files), default=0.0)
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        return self.display_name, self.color, 2, mtime, disp_t, False

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        grok_act = os.path.expanduser("~/.grok/active_sessions.json")
        sid, cwd = None, None

        if os.path.exists(grok_act):
            try:
                with open(grok_act) as f:
                    active = json.load(f)
                for s in active:
                    if str(s.get("pid")) in desc_pids:
                        sid, cwd = s.get("session_id"), s.get("cwd")
                        break
                if not sid and active:
                    sid, cwd = active[-1].get("session_id"), active[-1].get("cwd")
            except Exception:
                pass

        if sid and cwd:
            cwd_enc = urllib.parse.quote(cwd, safe="")
            hf = os.path.expanduser(f"~/.grok/sessions/{cwd_enc}/{sid}/chat_history.jsonl")
            if os.path.exists(hf):
                lines = read_tail_lines(hf, full=full_history)
                turns = extract_duck_turns(lines, full=full_history)
                if turns:
                    content = format_turns(turns, live=True, full_history=full_history, preview_width=preview_width)
                    return PreviewResult(
                        source_label=f"{self.display_name} · {disp_t}",
                        content=content
                    )
        return None


# ==============================================================================
# SECTION: Google Antigravity / AGY Adapter
# Source: adapters/antigravity.py
# ==============================================================================
"""Google Antigravity (AGY) / Gemini adapter."""

class AntigravityAdapter(BaseAgentAdapter):
    name = "antigravity"
    display_name = "🤖 AGY"
    color = C_AGY

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return "agy" in heads or "agy" in pane.current_command or bool(pane.agy_tag)

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        agy_titles = shared_state.get("agy_titles", {})
        m = re.search(r"--conversation[=\s]+([0-9a-fA-F\-]{36})", full_desc)
        cid = pane.agy_tag or (m.group(1) if m else "")
        mtime = 0.0
        rank = 2
        status = "💤 idle"
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        running = False

        if cid:
            tpath = os.path.expanduser(f"~/.gemini/antigravity-cli/brain/{cid}/.system_generated/logs/transcript.jsonl")
            if os.path.exists(tpath):
                mtime = get_real_dialogue_time(tpath)
            if cid in agy_titles:
                t, idle = agy_titles[cid]
                disp_t = t
                if idle:
                    status = "⚡ run"
                    rank = 1
                    running = True
                else:
                    status = "💤 idle"

        if disp_t.startswith("Ga=") or not disp_t.strip():
            disp_t = "[AGY Session]"

        return self.display_name, self.color, rank, mtime, disp_t, running

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        m = re.search(r"--conversation[=\s]+([0-9a-fA-F\-]{36})", full_desc)
        cid = pane.agy_tag or (m.group(1) if m else "")

        if not cid:
            agy_map = os.path.expanduser("~/.tmux/resurrect/agy_session_map.txt")
            if os.path.exists(agy_map):
                try:
                    with open(agy_map) as f:
                        for line in f:
                            parts = line.strip().split("\t")
                            if parts and parts[0] == pane.pane_id and len(parts) >= 2:
                                cid = parts[1]
                                break
                except Exception:
                    pass

        if cid:
            tpath = os.path.expanduser(f"~/.gemini/antigravity-cli/brain/{cid}/.system_generated/logs/transcript.jsonl")
            if os.path.exists(tpath):
                lines = read_tail_lines(tpath, full=full_history)
                turns = extract_duck_turns(lines, full=full_history)
                if turns:
                    is_live = False
                    try:
                        is_live = time.time() - os.path.getmtime(tpath) < 120
                    except Exception:
                        pass
                    content = format_turns(turns, live=is_live, full_history=full_history, preview_width=preview_width)
                    return PreviewResult(
                        source_label=f"{self.display_name} · {disp_t}",
                        content=content
                    )
        return None


# ==============================================================================
# SECTION: OpenCode Adapter
# Source: adapters/opencode.py
# ==============================================================================
"""OpenCode adapter."""

class OpenCodeAdapter(BaseAgentAdapter):
    name = "opencode"
    display_name = "🟢 OpenCode"
    color = C_OPENCODE

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return "opencode" in heads or "opencode" in pane.current_command or bool(pane.oc_tag)

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        oc_sessions = shared_state.get("oc_sessions", [])
        oc_db = shared_state.get("oc_db")

        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).removeprefix("OC | ").strip()
        mtime = 0.0
        rank = 2
        running = False

        cands = [s for s in oc_sessions if s[0] == pane.oc_tag or (disp_t and disp_t in (s[1] or ""))]
        if cands:
            sid, _, t_upd = max(cands, key=lambda s: (s[1] == disp_t, s[0] == pane.oc_tag, s[2] or 0))
            mtime = (t_upd or 0) / 1000.0
            if oc_db:
                try:
                    last = oc_db.execute(
                        "SELECT json_extract(data, '$.role'), json_extract(data, '$.time.completed') "
                        "FROM message WHERE session_id = ? ORDER BY time_created DESC LIMIT 1",
                        (sid,)
                    ).fetchone()
                    running = bool(last) and (last[0] == "user" or last[1] is None)
                    if running:
                        rank = 1
                except Exception:
                    pass

        return self.display_name, self.color, rank, mtime, disp_t, running

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).removeprefix("OC | ").strip()
        clean_t = disp_t.split("|")[0].strip("[]* ")
        db_path = os.path.expanduser("~/.local/share/opencode/opencode.db")

        if os.path.exists(db_path):
            try:
                conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
                row = conn.execute(
                    'SELECT id, title, time_updated FROM session WHERE parent_id IS NULL AND '
                    '(id = ? OR title LIKE ? OR ? LIKE "%" || title || "%") '
                    'ORDER BY title = ? DESC, id = ? DESC, time_updated DESC LIMIT 1',
                    (pane.oc_tag, f"%{clean_t}%", clean_t, disp_t, pane.oc_tag)
                ).fetchone()

                if row:
                    sid, stitle, t_upd = row
                    # 300 part limit keeps query latency ~40ms even on huge sessions
                    limit = -1 if full_history else 300
                    recs = [
                        json.dumps({"role": r, "content": txt})
                        for r, txt in conn.execute(
                            "SELECT json_extract(m.data, '$.role'), json_extract(p.data, '$.text') "
                            "FROM part p JOIN message m ON m.id = p.message_id "
                            "WHERE p.id IN (SELECT id FROM part WHERE session_id = ? ORDER BY time_created DESC LIMIT ?) "
                            "AND json_extract(p.data, '$.type') = 'text' AND json_extract(p.data, '$.synthetic') IS NOT 1 "
                            "ORDER BY p.time_created",
                            (sid, limit)
                        ) if txt
                    ]
                    turns = extract_duck_turns(recs, full=full_history)
                    if turns:
                        is_live = False
                        if t_upd:
                            is_live = (time.time() - t_upd / 1000.0) < 120
                        content = format_turns(turns, live=is_live, full_history=full_history, preview_width=preview_width)
                        conn.close()
                        return PreviewResult(
                            source_label=f"{self.display_name} · {stitle}",
                            content=content
                        )
                conn.close()
            except Exception:
                pass
        return None


# ==============================================================================
# SECTION: Oh My Pi (OMP) Adapter
# Source: adapters/omp.py
# ==============================================================================
"""Oh My Pi (OMP) adapter."""

OMP_RE = re.compile(r"(^|[\s/])omp(\s|$)")

def load_omp_sessions() -> List[Tuple[str, str, str]]:
    """Scan ~/.omp/agent/sessions to index (session_id, filepath, title)."""
    idx = []
    for p in glob.glob(os.path.expanduser("~/.omp/agent/sessions/*/*.jsonl")):
        try:
            with open(p, "r", encoding="utf-8", errors="ignore") as f:
                first = f.readline()
                title = json.loads(first).get("title") or ""
                sid = p.rsplit("_", 1)[-1][:-6]
                idx.append((sid, p, title))
        except Exception:
            pass
    return idx

class OmpAdapter(BaseAgentAdapter):
    name = "omp"
    display_name = "🟣 OMP"
    color = C_OMP

    def detect(self, pane: PaneContext, full_desc: str, heads: str) -> bool:
        return bool(OMP_RE.search(heads)) or pane.current_command == "omp" or bool(OMP_RE.search(full_desc))

    def get_status(
        self,
        pane: PaneContext,
        full_desc: str,
        heads: str,
        shared_state: Dict[str, Any]
    ) -> Tuple[str, str, int, float, str, bool]:
        omp_idx = shared_state.setdefault("omp_idx", load_omp_sessions())
        cmd_of = shared_state.get("cmd_of", {})

        m = re.match(r"π (\S)\s*(.*)", pane.title)
        disp_t = re.sub(r"^[✳*★☆✦✧⠀-⣿\s]+", "", pane.title).strip()
        state, t = m.groups() if m else (">", disp_t)

        status = "💤 idle"
        rank = 2
        running = False
        if state == "!":
            status = "🔔 input"
            rank = 0
        elif state != ">":
            status = "⚡ run"
            rank = 1
            running = True

        ids = {pane.omp_tag} | set(re.findall(r"(?:-r|--resume|resume)\s+([0-9a-f-]{36})", cmd_of.get(pane.pid, "") + " " + full_desc))
        cands = [s for s in omp_idx if s[2] == t or s[0] in ids]
        mtime = 0.0
        if cands:
            best_file = max(cands, key=lambda s: (s[2] == t, s[0] in ids, os.path.getmtime(s[1])))[1]
            mtime = get_real_dialogue_time(best_file)

        return self.display_name, self.color, rank, mtime, t, running

    def get_preview(
        self,
        pane: PaneContext,
        full_desc: str,
        desc_pids: List[str],
        full_history: bool,
        preview_width: int
    ) -> Optional[PreviewResult]:
        label = re.sub(r"^π \S\s*", "", pane.title)
        ids = {pane.omp_tag} | set(re.findall(r"(?:-r|--resume|resume)\s+([0-9a-f-]{36})", full_desc))
        best = None

        for p in glob.glob(os.path.expanduser("~/.omp/agent/sessions/*/*.jsonl")):
            try:
                with open(p, "r", encoding="utf-8", errors="ignore") as f:
                    st = json.loads(f.readline()).get("title") or ""
            except Exception:
                continue
            key = (st == label, p.rsplit("_", 1)[-1][:-6] in ids, os.path.getmtime(p))
            if (key[0] or key[1]) and (best is None or key > best[0]):
                best = (key, p, st)

        if best:
            turns = extract_duck_turns(read_tail_lines(best[1], full=full_history), full=full_history)
            if turns:
                is_live = False
                try:
                    is_live = time.time() - best[0][2] < 120
                except Exception:
                    pass
                content = format_turns(turns, live=is_live, full_history=full_history, preview_width=preview_width)
                return PreviewResult(
                    source_label=f"{self.display_name} · {best[2] or label}",
                    content=content
                )
        return None


